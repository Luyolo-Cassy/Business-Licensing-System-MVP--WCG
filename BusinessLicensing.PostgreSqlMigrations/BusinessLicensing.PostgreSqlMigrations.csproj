<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BusinessLicensing.PostgreSqlMigrations</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ProvincialBusinessLicensingSystem.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <Target Name="CopyMigrationsAssemblyToWebOutput" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="../bin/$(Configuration)/$(TargetFramework)" />
  </Target>

</Project>
