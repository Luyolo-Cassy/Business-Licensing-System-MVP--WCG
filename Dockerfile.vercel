FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS build

WORKDIR /src

COPY ProvincialBusinessLicensingSystem.csproj ./
COPY BusinessLicensing.PostgreSqlMigrations/BusinessLicensing.PostgreSqlMigrations.csproj BusinessLicensing.PostgreSqlMigrations/

RUN dotnet restore BusinessLicensing.PostgreSqlMigrations/BusinessLicensing.PostgreSqlMigrations.csproj

COPY . .

RUN dotnet build BusinessLicensing.PostgreSqlMigrations/BusinessLicensing.PostgreSqlMigrations.csproj \
    --configuration Release \
    --no-restore

RUN dotnet publish ProvincialBusinessLicensingSystem.csproj \
    --configuration Release \
    --output /app/publish \
    --no-build

FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble AS runtime

WORKDIR /app

COPY --from=build /app/publish ./

# TEMPORARY DIAGNOSTIC — remove after verifying the Vercel build.
RUN set -eu; \
    status=0; \
    for file in \
        /app/wwwroot/_framework/blazor.web.js \
        /app/ProvincialBusinessLicensingSystem.staticwebassets.endpoints.json; \
    do \
        if test -f "$file"; then \
            echo "FOUND: $file"; \
            ls -ln "$file"; \
        else \
            echo "MISSING: $file"; \
            status=1; \
        fi; \
    done; \
    exit "$status"

ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

USER $APP_UID

CMD ["sh", "-c", "exec dotnet ProvincialBusinessLicensingSystem.dll --urls \"http://0.0.0.0:${PORT}\""]
