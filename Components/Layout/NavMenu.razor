@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row navbar">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <PhosphorIcon Name="buildings" CssClass="nav-brand-icon" />
            <span>Provincial Business Licensing System</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        <!-- Business Owner Menu -->
        <AuthorizeView Roles="BusinessOwner">
            <Authorized>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <PhosphorIcon Name="house" CssClass="nav-menu-icon" />
                        Home
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="dashboard">
                        <PhosphorIcon Name="gauge" CssClass="nav-menu-icon" />
                        Dashboard
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="new-application">
                        <PhosphorIcon Name="file-plus" CssClass="nav-menu-icon" />
                        New Application
                    </NavLink>
                </div>


            </Authorized>
        </AuthorizeView>

        <!-- Municipal Official Menu -->
        <AuthorizeView Roles="MunicipalOfficial">
            <Authorized>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="official-dashboard">
                        <PhosphorIcon Name="gauge" CssClass="nav-menu-icon" />
                        Dashboard
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="generate-report">
                        <PhosphorIcon Name="chart-bar" CssClass="nav-menu-icon" />
                        Reports
                    </NavLink>
                </div>

            </Authorized>
        </AuthorizeView>

        <!-- Logout (all logged-in users) -->
        <AuthorizeView>
            <Authorized Context="authContext">

                <div class="nav-item px-3 mt-4">
                    <NavLink class="nav-link text-danger" href="logout">
                        <PhosphorIcon Name="sign-out" CssClass="nav-menu-icon" />
                        Logout
                    </NavLink>
                </div>

            </Authorized>
        </AuthorizeView>

    </nav>

</div>
