@using Microsoft.AspNetCore.Components.Authorization

<div class="side-brand">
    <a href="/" class="side-brand-link" title="Provincial Business Licensing System" aria-label="Provincial Business Licensing System home">
        <PhosphorIcon Name="buildings" CssClass="nav-brand-icon" />
        <span class="side-label">Business Licensing</span>
    </a>
    <button type="button" class="side-mobile-close" data-mobile-close aria-label="Close navigation">
        <PhosphorIcon Name="x-circle" />
    </button>
</div>

<button type="button" class="side-collapse" data-sidebar-toggle aria-label="Collapse sidebar" aria-controls="app-navigation" aria-expanded="true" title="Collapse sidebar">
    <PhosphorIcon Name="arrow-left" />
    <span class="side-label">Collapse menu</span>
</button>

<nav class="side-nav" aria-label="Role navigation">
    <AuthorizeView Roles="BusinessOwner">
        <Authorized>
            <NavLink class="side-link" href="" Match="NavLinkMatch.All" title="Home" aria-label="Home">
                <PhosphorIcon Name="house" CssClass="nav-menu-icon" /><span class="side-label">Home</span>
            </NavLink>
            <NavLink class="side-link" href="dashboard" title="Dashboard" aria-label="Dashboard">
                <PhosphorIcon Name="gauge" CssClass="nav-menu-icon" /><span class="side-label">Dashboard</span>
            </NavLink>
            <NavLink class="side-link" href="new-application" title="New Application" aria-label="New Application">
                <PhosphorIcon Name="file-plus" CssClass="nav-menu-icon" /><span class="side-label">New Application</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="MunicipalOfficial">
        <Authorized>
            <NavLink class="side-link" href="official-dashboard" title="Dashboard" aria-label="Dashboard">
                <PhosphorIcon Name="gauge" CssClass="nav-menu-icon" /><span class="side-label">Dashboard</span>
            </NavLink>
            <NavLink class="side-link" href="generate-report" title="Reports" aria-label="Reports">
                <PhosphorIcon Name="chart-bar" CssClass="nav-menu-icon" /><span class="side-label">Reports</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="DEDATAdmin">
        <Authorized>
            <NavLink class="side-link" href="admin-dashboard" title="Admin Dashboard" aria-label="Admin Dashboard">
                <PhosphorIcon Name="gauge" CssClass="nav-menu-icon" /><span class="side-label">Admin Dashboard</span>
            </NavLink>
            <NavLink class="side-link" href="admin/applications" title="Applications" aria-label="Applications">
                <PhosphorIcon Name="files" CssClass="nav-menu-icon" /><span class="side-label">Applications</span>
            </NavLink>
            <NavLink class="side-link" href="admin/reports" title="Reports" aria-label="Reports">
                <PhosphorIcon Name="chart-bar" CssClass="nav-menu-icon" /><span class="side-label">Reports</span>
            </NavLink>
            <NavLink class="side-link" href="admin/municipalities" title="Municipalities" aria-label="Municipalities">
                <PhosphorIcon Name="buildings" CssClass="nav-menu-icon" /><span class="side-label">Municipalities</span>
            </NavLink>
            <NavLink class="side-link" href="admin/officials" title="Municipal Officials" aria-label="Municipal Officials">
                <PhosphorIcon Name="users" CssClass="nav-menu-icon" /><span class="side-label">Municipal Officials</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>
</nav>
