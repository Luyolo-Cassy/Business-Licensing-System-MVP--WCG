@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row navbar">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <span class="bi bi-building-nav-menu" aria-hidden="true"></span>
            <span>Provincial Business Licensing System</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        <!-- Business Owner Menu -->
        <AuthorizeView Roles="BusinessOwner">
            <Authorized>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu"></span>
                        Home
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="dashboard">
                        <span class="bi bi-speedometer-nav-menu"></span>
                        Dashboard
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="new-application">
                        <span class="bi bi-file-earmark-plus-nav-menu"></span>
                        New Application
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="tracking">
                        <span class="bi bi-list-nested-nav-menu"></span>
                        Application Tracking
                    </NavLink>
                </div>

            </Authorized>
        </AuthorizeView>

        <!-- Municipal Official Menu -->
        <AuthorizeView Roles="MunicipalOfficial">
            <Authorized>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="official-dashboard">
                        <span class="bi bi-speedometer-nav-menu"></span>
                        Dashboard
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="reports">
                        <span class="bi bi-bar-chart"></span>
                        Reports
                    </NavLink>
                </div>

            </Authorized>
        </AuthorizeView>

        <!-- Logout (all logged-in users) -->
        <AuthorizeView>
            <Authorized Context="authContext">

                <div class="nav-item px-3 mt-4">
                    <NavLink class="nav-link text-danger" href="logout">
                        <span class="bi bi-box-arrow-right"></span>
                        Logout
                    </NavLink>
                </div>

            </Authorized>
        </AuthorizeView>

    </nav>

</div>