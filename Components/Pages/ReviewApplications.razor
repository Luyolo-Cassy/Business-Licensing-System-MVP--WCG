@page "/review-application/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "MunicipalOfficial")]
@implements IDisposable

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using BusinessLicensing_Practice.Data
@using BusinessLicensing_Practice.Models
@using BusinessLicensing_Practice.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@inject MunicipalMessageService Messages
@inject ApplicationCorrectionService Corrections
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationSummaryService Summaries

<PageTitle>Review Application</PageTitle>

@if (application == null)
{
    <div class="alert alert-danger">
        Application not found.
    </div>
}
else
{
    <h2 class="mb-4">Review Business Licence Application</h2>

    <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
        <div>
            <strong>Current Status:</strong>
            <span class="badge @GetBadge(application?.Status)">
                @application?.Status
            </span>
        </div>

        <div>
            Submitted:
            <strong>@application?.DateSubmitted.ToString("dd MMM yyyy")</strong>
        </div>
    </div>

    @if (summaryState.Status != AiApplicationSummaryStatus.Disabled)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-bold">AI Application Summary</div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(summaryState.Summary))
                {
                    <p style="white-space:pre-wrap">@displayedSummary</p>
                    <p class="text-muted mb-0"><strong>AI-generated summary.</strong> Please verify the information against the full application before making a decision.</p>
                }
                else
                {
                    <p>Generate a concise AI-assisted overview of the structured application information. Supporting-document contents are not sent.</p>
                    <button type="button" class="btn btn-primary" disabled="@summaryLoading" @onclick="GenerateSummary">
                        @if (summaryLoading) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        @(summaryLoading ? "Generating summary..." : "Get AI Summary")
                    </button>
                    @if (summaryUnavailable) { <div class="alert alert-warning mt-3 mb-0">AI summary is currently unavailable. Please review the application information below.</div> }
                }
            </div>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">
            Application Details
        </div>

        <div class="card-body">
            <h5 class="mb-3">Application Progress</h5>

            <div class="progress mb-4" style="height:25px;">
                <div class="progress-bar bg-success" role="progressbar" style="width:@GetProgressPercentage()%">

                    @application?.Status

                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Application Number</strong><br />
                    @application!.ApplicationNumber
                </div>

                <div class="col-md-6">
                    <strong>Date Submitted</strong><br />
                    @application.DateSubmitted.ToString("yyyy/MM/dd")
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Business Name</strong><br />
                    @application.BusinessName
                </div>

               
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Licence Type</strong><br />
                    @application.LicenceType
                </div>

               
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Registration Number</strong><br />
                    @application.RegistrationNumber
                </div>

                <div class="col-md-6">
                    <strong>Tax Number</strong><br />
                    @application.TaxNumber
                </div>
            </div>

            <hr />

            <h5>Place of Business / Trading Address</h5>

            <p>
                @ApplicationEntry.PlaceOfBusinessAddress(application)
            </p>

            @if (application.Details != null)
            {
                <hr />
                <h5>Applicant Information</h5>
                <div class="row mb-3">
                    <div class="col-md-6"><strong>Applicant</strong><br />@ApplicationEntry.FullName(application.Details)</div>
                    <div class="col-md-6"><strong>Application Type</strong><br />@application.Details.ApplicationType</div>
                    <div class="col-md-6 mt-3"><strong>Telephone</strong><br />@application.Details.ApplicantTelephone</div>
                    <div class="col-md-6 mt-3"><strong>Email</strong><br />@application.Details.ApplicantEmail</div>
                    <div class="col-md-6 mt-3"><strong>Applicant Address</strong><br />@ApplicationEntry.ApplicantAddress(application.Details)</div>
                    <div class="col-md-6 mt-3"><strong>Postal Address</strong><br />@ApplicationEntry.PostalAddress(application)</div>
                    <div class="col-md-6 mt-3"><strong>Trading Hours</strong><br /><span style="white-space: pre-line">@ApplicationEntry.FormatTradingHours(application.Details.TradingHours)</span></div>
                    <div class="col-md-6 mt-3"><strong>Open on public holidays</strong><br />@ApplicationEntry.FormatPublicHolidayTrading(application.Details.OpenOnPublicHolidays)</div>
                </div>

                <h5>Licence-Specific Information</h5>
                @foreach (var answer in ApplicationPdfService.GetLicenceSpecificRows(application.LicenceType, application.Details.LicenceSpecificDetailsJson))
                {
                    <p><strong>@answer.Label:</strong> @(string.IsNullOrWhiteSpace(answer.Value) ? "Not provided" : answer.Value)</p>
                }
            }

            @if (!string.IsNullOrWhiteSpace(application.FoodHandlingType))
            {
                <p>
                    <strong>Food Handling Type:</strong>
                    @application.FoodHandlingType
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(application.EntertainmentActivityType))
            {
                <p>
                    <strong>Entertainment Activity:</strong>
                    @application.EntertainmentActivityType
                </p>
            }

            <hr />

            <h5>Official Application PDF</h5>

            @if (application.Details != null && !string.IsNullOrWhiteSpace(application.ApplicationFormFilePath))
            {
                <div class="card p-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <strong>System-Generated Official Application</strong><br />

                            <small class="text-muted">
                                Submitted by <strong>@application?.User?.FullName</strong>
                            </small>

                        </div>

                        <a class="btn btn-primary" href="/applications/@application!.Id/official-pdf" target="_blank">

                            <PhosphorIcon Name="file-pdf" CssClass="me-1" />

                            Open Generated PDF

                        </a>

                    </div>

                </div>
            }
            else if (!string.IsNullOrWhiteSpace(application.ApplicationFormFilePath))
            {
                <div class="card p-3"><div class="d-flex justify-content-between align-items-center"><strong>Legacy Uploaded Application Form</strong><a class="btn btn-outline-primary" href="@application.ApplicationFormFilePath" target="_blank"><PhosphorIcon Name="eye" />Open Legacy Form</a></div></div>
            }
            else
            {
                <div class="alert alert-warning">

                    No application PDF is available for this legacy record.

                </div>
            }

            

            <hr />

            <h5>Supporting Documents</h5>

            @if (application.Documents.Any())
            {
                <ul class="list-group mb-4">
                    @foreach (var doc in application.Documents)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            @doc.FileName
                            <a class="btn btn-primary btn-sm" href="@doc.FilePath" target="_blank">
                                <PhosphorIcon Name="eye" />
                                View
                            </a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="alert alert-warning">
                    No supporting documents uploaded.
                </div>
            }

            <hr />


            <h5>Officer Review Notes</h5>

            @if (communicationHistory.Count > 0)
            {
                <div class="mb-4">
                    @foreach (var message in communicationHistory)
                    {
                        <article class="border-start ps-3 mb-3">
                            <div class="small text-muted">@message.SenderName · @message.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                            @if (message.MessageType == ApplicationWorkflow.CorrectionRequestMessage) { <span class="badge bg-warning text-dark">Correction request @(message.ResolvedAtUtc.HasValue ? "resolved" : "open")</span> }
                            <div style="white-space:pre-wrap">@message.Content</div>
                        </article>
                    }
                </div>
            }

            <div class="mb-3">
                <label class="form-label">
                    Message to applicant
                </label>

                <InputTextArea class="form-control" @bind-Value="ReviewComments" rows="4" disabled="@saving">
                </InputTextArea>
            </div>

            <p class="form-text">This note is visible to the applicant and creates an unread notification when you save the review.</p>
            <button class="btn btn-warning mb-4" disabled="@saving" @onclick="RequestAdditionalInformation">
                @if (saving && activeReviewAction == "correction") { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                Request Additional Information
            </button>
            <p class="form-text mt-n3">Enter a message above explaining exactly what must be corrected, clarified, replaced, or uploaded.</p>
            <h5>Review Decision</h5>

            <div class="mb-3">

                <label class="form-label">Application Status</label>

                <InputSelect class="form-select" @bind-Value="application.Status" disabled="@saving">
                    <option value="Submitted">Submitted</option>
                    <option value="Under Review">Under Review</option>
                    <option value="Department Assessment">Department Assessment</option>
                    <option value="Final Decision">Final Decision</option>
                    <option value="Licence Issued">Licence Issued</option>
                    <option value="Rejected">Rejected</option>
                    <option value="Withdrawn">Withdrawn</option>
                </InputSelect>

            </div>

            @if (ShowSuccess)
            {
                <div class="alert alert-success">
                    Review saved successfully.
                </div>
            }

            @if (saveError != null)
            {
                <div class="alert alert-danger" role="alert">@saveError</div>
            }

            <div class="mt-4">

                <button class="btn btn-success me-2" disabled="@saving" @onclick="@(() => SaveReview("save"))">
                    @if (saving && activeReviewAction == "save") { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } else { <PhosphorIcon Name="floppy-disk" CssClass="me-1" /> }
                    @(saving && activeReviewAction == "save" ? "Saving review..." : "Save Review")
                </button>

                <button class="btn btn-secondary me-2" disabled="@saving" @onclick="@(() => Navigation.NavigateTo("/official-dashboard"))">

                    <PhosphorIcon Name="arrow-left" CssClass="me-1" />

                    Back
                </button>

                @if (application?.Status == "Final Decision")
                {
                    <button class="btn btn-primary me-2" disabled="@saving" @onclick="ApproveApplication">
                        @if (saving && activeReviewAction == "approve") { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } else { <PhosphorIcon Name="check-circle" /> }
                        @(saving && activeReviewAction == "approve" ? "Approving application..." : "Approve")
                    </button>

                    <button class="btn btn-danger" disabled="@saving" @onclick="RejectApplication">
                        @if (saving && activeReviewAction == "reject") { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } else { <PhosphorIcon Name="x-circle" /> }
                        @(saving && activeReviewAction == "reject" ? "Rejecting application..." : "Reject")
                    </button>
                }

            </div>
            @if (saving) { <p class="mt-2 text-muted" role="status">@ReviewStatus</p> }

        </div>
    </div>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private Application? application;
    private string ReviewComments = "";
    private List<MunicipalMessage> communicationHistory = [];
    private bool ShowSuccess = false;
    private bool saving;
    private string? activeReviewAction;
    private string ReviewStatus => activeReviewAction switch { "approve" => "Approving application...", "reject" => "Rejecting application...", _ => "Saving review..." };
    private string? saveError;
    private AiApplicationSummaryResult summaryState = new(AiApplicationSummaryStatus.Disabled);
    private string? displayedSummary;
    private bool summaryLoading;
    private bool summaryUnavailable;
    private CancellationTokenSource? summaryAnimationCancellation;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var official = await OfficialAccess.GetAsync(Db, authState.User);
        if (official == null || string.IsNullOrWhiteSpace(official.Municipality)) return;

        application = await Db.Applications
            .Include(a => a.Documents)
            .Include(a => a.User)
            .Include(a => a.Details)
            .FirstOrDefaultAsync(a => a.Id == Id && a.Municipality == official.Municipality);
        if (application != null)
        {
            communicationHistory = await Db.MunicipalMessages.AsNoTracking().Where(m => m.ApplicationId == application.Id)
                .OrderBy(m => m.CreatedAtUtc).ThenBy(m => m.Id).ToListAsync();
            summaryState = await Summaries.GetCurrentAsync(authState.User, application.Id);
            displayedSummary = summaryState.Summary;
        }

    }

    private async Task GenerateSummary()
    {
        if (application == null || summaryLoading || summaryState.Summary != null) return;
        summaryLoading = true; summaryUnavailable = false;
        try
        {
            summaryState = await Summaries.GenerateAsync((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User, application.Id);
            summaryUnavailable = summaryState.Status == AiApplicationSummaryStatus.Unavailable;
            if (summaryState.Status == AiApplicationSummaryStatus.Generated && summaryState.Summary is { } generatedSummary)
                await AnimateSummaryAsync(generatedSummary);
            else
                displayedSummary = summaryState.Summary;
        }
        catch (UnauthorizedAccessException) { summaryUnavailable = true; }
        finally { summaryLoading = false; }
    }

    private async Task AnimateSummaryAsync(string summary)
    {
        summaryAnimationCancellation?.Cancel();
        summaryAnimationCancellation?.Dispose();
        var cancellation = summaryAnimationCancellation = new CancellationTokenSource();
        try
        {
            var words = System.Text.RegularExpressions.Regex.Matches(summary, @"\S+\s*");
            if (words.Count == 0) { displayedSummary = summary; return; }
            var wordsPerFrame = Math.Max(1, (int)Math.Ceiling(words.Count / 100d));
            var frameCount = (int)Math.Ceiling(words.Count / (double)wordsPerFrame);
            var delayMilliseconds = Math.Clamp(2800 / frameCount, 25, 120);
            for (var word = wordsPerFrame; word < words.Count + wordsPerFrame; word += wordsPerFrame)
            {
                cancellation.Token.ThrowIfCancellationRequested();
                var lastWord = words[Math.Min(word, words.Count) - 1];
                displayedSummary = summary[..(lastWord.Index + lastWord.Length)];
                await InvokeAsync(StateHasChanged);
                if (word < words.Count)
                    await Task.Delay(delayMilliseconds, cancellation.Token);
            }
            displayedSummary = summary;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch { displayedSummary = summary; }
        finally
        {
            if (ReferenceEquals(summaryAnimationCancellation, cancellation)) summaryAnimationCancellation = null;
            cancellation.Dispose();
        }
    }

    public void Dispose()
    {
        summaryAnimationCancellation?.Cancel();
    }

    private async Task SaveReview(string action)
    {
        if (application != null && !saving)
        {
            saving = true;
            activeReviewAction = action;
            saveError = null;
            try
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                await Messages.SaveReviewAsync(authState.User, application.Id, application.Status, ReviewComments);
                ReviewComments = "";
            }
            catch (UnauthorizedAccessException)
            {
                saveError = "You no longer have access to review this application.";
                return;
            }
            catch (DbUpdateException)
            {
                saveError = "The review could not be saved. Your message is still here; please try again.";
                return;
            }
            finally
            {
                saving = false;
                activeReviewAction = null;
            }

            ShowSuccess = true;



            Navigation.NavigateTo("/official-dashboard");
        }
    }

    private async Task ApproveApplication()
    {
        if (saving) return;
        var previousStatus = application!.Status;
        application!.Status = "Licence Issued";
        await SaveReview("approve");
        if (saveError != null) application.Status = previousStatus;
    }

    private async Task RequestAdditionalInformation()
    {
        if (application == null || saving) return;
        saving = true; activeReviewAction = "correction"; saveError = null;
        try
        {
            await Corrections.RequestCorrectionsAsync((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User,
                application.Id, ReviewComments);
            Navigation.NavigateTo("/official-dashboard");
        }
        catch (UnauthorizedAccessException) { saveError = "You no longer have access to review this application."; }
        catch (System.ComponentModel.DataAnnotations.ValidationException error) { saveError = error.Message; }
        catch (DbUpdateException) { saveError = "The correction request could not be saved. Please try again."; }
        finally { saving = false; activeReviewAction = null; }
    }

    private async Task RejectApplication()
    {
        if (saving) return;
        var previousStatus = application!.Status;
        application!.Status = "Rejected";
        await SaveReview("reject");
        if (saveError != null) application.Status = previousStatus;
    }

    private string GetBadge(string? status)
    {
        return status switch
        {
            "Submitted" => "bg-secondary",
            "Under Review" => "bg-primary",
            "Additional Information Required" => "bg-warning text-dark",
            "Department Assessment" => "bg-warning text-dark",
            "Final Decision" => "bg-info text-dark",
            "Licence Issued" => "bg-success",
            "Rejected" => "bg-danger",
            "Withdrawn" => "bg-dark",
            _ => "bg-secondary"
        };
    }

    private int GetProgressPercentage()
    {
        return application?.Status switch
        {
            "Submitted" => 20,
            "Under Review" => 40,
            "Additional Information Required" => 40,
            "Department Assessment" => 60,
            "Final Decision" => 80,
            "Licence Issued" => 100,
            "Rejected" => 100,
            "Withdrawn" => 100,
            _ => 0
        };
    }

}
