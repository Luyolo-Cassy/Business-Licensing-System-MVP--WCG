@page "/new-application"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "BusinessOwner")]

@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using BusinessLicensing_Practice.Data
@using BusinessLicensing_Practice.Models
@using BusinessLicensing_Practice.Services

@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject IWebHostEnvironment Environment
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ApplicationPdfService PdfService
@inject ApplicationFileService FileService
@inject ProtectedUploadService Uploads
@inject MunicipalRoutingService RoutingService
@inject IJSRuntime JS

<div id="application-wizard-top"><h3 class="fw-bold mb-4">New Business Licence Application</h3></div>
<div class="progress mb-3" aria-label="Application progress">
    <div class="progress-bar bg-success" role="progressbar" style="width:@((CurrentStep * 100) / TotalSteps)%" aria-valuenow="@CurrentStep" aria-valuemin="1" aria-valuemax="@TotalSteps">Step @CurrentStep of @TotalSteps</div>
</div>
<div class="mb-4"><span class="badge bg-primary">Step @CurrentStep of @TotalSteps</span><span class="ms-2 text-muted">@StepTitle</span></div>

@if (!string.IsNullOrWhiteSpace(Message)) { <div class="alert @(MessageIsError ? "alert-danger" : "alert-info") mb-3" role="@(MessageIsError ? "alert" : "status")" aria-live="polite">@Message</div> }
<fieldset class="application-fields wizard-step-enter" @key="CurrentStep" disabled="@IsSubmitting" aria-busy="@IsSubmitting">
@if (CurrentStep == 1)
{
    <section class="licence-type-step" aria-labelledby="licence-type-heading">
        <div class="licence-type-header"><h4 id="licence-type-heading" class="fw-bold mb-2">Select Licence Type</h4><p class="text-muted mb-0">Your selection determines the questions and supporting documents required.</p></div>
        <div class="row g-4" role="radiogroup" aria-labelledby="licence-type-heading">
            @foreach (var option in LicenceApplicationCatalog.Licences)
            {
                var selected = LicenceType == option.Name;
                <div class="col-12 col-md-6 col-xl-4"><label class="licence-type-card card h-100 @(selected ? "is-selected" : "")">
                    <span class="visually-hidden">@option.Name</span><div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-start justify-content-between gap-3 mb-3"><span class="licence-type-icon"><PhosphorIcon Name="@option.IconClass" /></span><input class="form-check-input licence-type-radio" type="radio" name="licenceType" value="@option.Name" checked="@selected" @onchange="@(() => SelectLicence(option))" /></div>
                        <h5 class="licence-type-title">@option.Name</h5><p class="licence-type-description">@option.Description</p>
                        <div class="licence-type-state mt-auto">@(selected ? "Selected" : "Select licence")</div>
                    </div>
                </label></div>
            }
        </div>
    </section>
}

@if (CurrentStep == 2)
{
    <section class="business-info-step" aria-labelledby="applicant-heading">
        <div class="business-info-header"><h4 id="applicant-heading" class="fw-bold mb-2">Applicant Details</h4><p class="text-muted mb-0">Provide the applicant or authorised representative details for the official record.</p></div>
        <div class="card business-info-card mb-4"><div class="card-body">
            <div class="business-info-card-heading"><span class="business-info-card-icon"><PhosphorIcon Name="user" /></span><h5 class="mb-0">Application Information</h5></div>
            <div class="row g-3">
                <div class="col-12 col-md-6">@FieldLabel("applicationType", "Application Type")<select id="applicationType" class="form-select" @bind="ApplicationType"><option value="">Select application type</option><option>New application</option><option>Renewal</option><option>Amendment</option></select></div>
                <div class="col-12 col-md-6">@FieldLabel("applicantFirstName", "First Name")<input id="applicantFirstName" class="form-control" maxlength="100" autocomplete="given-name" @bind="ApplicantFirstName" /></div>
                <div class="col-12 col-md-6">@FieldLabel("applicantLastName", "Last Name")<input id="applicantLastName" class="form-control" maxlength="100" autocomplete="family-name" @bind="ApplicantLastName" /></div>
                <div class="col-12">@FieldLabel("applicantAddressLine1", "Address Line 1")<input id="applicantAddressLine1" class="form-control" maxlength="150" autocomplete="address-line1" @bind="ApplicantAddressLine1" /></div>
                <div class="col-12"><label class="form-label fw-semibold" for="applicantAddressLine2">Address Line 2</label><input id="applicantAddressLine2" class="form-control" maxlength="150" autocomplete="address-line2" @bind="ApplicantAddressLine2" /></div>
                <div class="col-12 col-md-6">@FieldLabel("applicantSuburb", "Suburb")<input id="applicantSuburb" class="form-control" maxlength="100" @bind="ApplicantSuburb" /></div>
                <div class="col-12 col-md-6">@FieldLabel("applicantCity", "City / Town")<input id="applicantCity" class="form-control" maxlength="100" autocomplete="address-level2" @bind="ApplicantCity" /></div>
                <div class="col-12 col-md-4">@FieldLabel("applicantPostalCode", "Postal Code")<input id="applicantPostalCode" class="form-control" maxlength="12" inputmode="numeric" autocomplete="postal-code" @bind="ApplicantPostalCode" /></div>
                <div class="col-12 col-md-6">@FieldLabel("applicantTelephone", "Telephone Number")<input id="applicantTelephone" class="form-control" type="tel" @bind="ApplicantTelephone" /></div>
                <div class="col-12 col-md-6">@FieldLabel("applicantEmail", "Email Address")<input id="applicantEmail" class="form-control" type="email" @bind="ApplicantEmail" /></div>
            </div>
        </div></div>
    </section>
}

@if (CurrentStep == 3)
{
    <section class="business-info-step" aria-labelledby="business-heading">
        <div class="business-info-header"><h4 id="business-heading" class="fw-bold mb-2">Business Details</h4><p class="text-muted mb-0">Enter the common business and premises information required for the application.</p></div>
        <div class="card business-info-card mb-4"><div class="card-body">
            <div class="business-info-card-heading"><span class="business-info-card-icon"><PhosphorIcon Name="buildings" /></span><h5 class="mb-0">Business Information</h5></div>
            <div class="row g-3">
                <div class="col-12 col-md-6">@FieldLabel("businessName", "Business Name")<input id="businessName" class="form-control" @bind="BusinessName" /></div>
                <div class="col-12 col-md-6">@FieldLabel("registrationNumber", "Company Registration Number")<input id="registrationNumber" class="form-control" maxlength="14" aria-describedby="registrationHelp" @bind="RegistrationNumber" /><div id="registrationHelp" class="form-text">Format: YYYY/NNNNNN/XX</div></div>
                <div class="col-12 col-md-6">@FieldLabel("taxNumber", "Tax Number")<input id="taxNumber" class="form-control" type="text" inputmode="numeric" maxlength="10" aria-describedby="taxHelp" @bind="TaxNumber" /><div id="taxHelp" class="form-text">Enter the 10-digit tax reference number.</div></div>
                <div class="col-12">@FieldLabel("businessCategory", "Nature of Business")<textarea id="businessCategory" class="form-control" rows="2" @bind="BusinessCategory"></textarea></div>
                <div class="col-12 col-md-6">@FieldLabel("contactPerson", "Contact Person")<input id="contactPerson" class="form-control" @bind="ContactPerson" /></div>
                <div class="col-12 col-md-6">@FieldLabel("businessTelephone", "Business Telephone")<input id="businessTelephone" class="form-control" type="tel" @bind="BusinessTelephone" /></div>
                <div class="col-12 col-md-6">@FieldLabel("businessEmail", "Business Email")<input id="businessEmail" class="form-control" type="email" @bind="BusinessEmail" /></div>
                <div class="col-12"><div class="form-label fw-semibold">Trading Hours</div><p class="form-text mt-0">For Open days, enter 24-hour times as HH:mm (for example 08:00 and 17:00).</p><div class="trading-hours-list" id="tradingHours">@foreach (var day in TradingDays) { <div class="trading-hours-row" @key="day.Day"><strong>@day.Day</strong><select class="form-select" aria-label="@day.Day trading status" value="@(day.IsOpen == true ? "open" : day.IsOpen == false ? "closed" : "")" @onchange="e => SetDayStatus(day, e.Value?.ToString())"><option value="">Select status</option><option value="open">Open</option><option value="closed">Closed</option></select>@if (day.IsOpen == true) { <label>Opening Time <input class="form-control" type="text" placeholder="HH:mm" maxlength="5" autocomplete="off" @bind="day.OpeningTime" @bind:event="oninput" /></label><label>Closing Time <input class="form-control" type="text" placeholder="HH:mm" maxlength="5" autocomplete="off" @bind="day.ClosingTime" @bind:event="oninput" /></label> } else if (day.IsOpen == false) { <span class="text-muted">Closed</span> }</div> }</div></div>
            </div>
        </div></div>
        <div class="card business-info-card mb-4"><div class="card-body">
            <div class="business-info-card-heading"><span class="business-info-card-icon"><PhosphorIcon Name="map-pin" /></span><h5 class="mb-0">Place of Business / Trading Address</h5></div>
            <p class="text-muted">Enter the physical address where the business operates or trades.</p>
            <div class="row g-3">
                <div class="col-12">@FieldLabel("addressLine1", "Address Line 1")<input id="addressLine1" class="form-control" @bind="PlaceOfBusinessAddressLine1" /></div>
                <div class="col-12"><label class="form-label fw-semibold" for="addressLine2">Address Line 2</label><input id="addressLine2" class="form-control" @bind="PlaceOfBusinessAddressLine2" /></div>
                <div class="col-12 col-md-6">@FieldLabel("suburb", "Suburb")<input id="suburb" class="form-control" @bind="PlaceOfBusinessSuburb" /></div>
                <div class="col-12 col-md-6">@FieldLabel("city", "Town / City")<input id="city" class="form-control" @bind="PlaceOfBusinessCity" /></div>
                <div class="col-12 col-md-4">@FieldLabel("postalCode", "Postal Code")<input id="postalCode" class="form-control" @bind="PlaceOfBusinessPostalCode" /></div>
                <div class="col-12 col-md-8"><p class="text-muted">Your responsible municipality will be determined from your trading address when you submit.</p></div>
                <div class="col-12"><fieldset><legend class="form-label fw-semibold fs-6">Is your postal address the same as your Place of Business / Trading Address? <span class="text-danger">*</span></legend><div id="postalSameAsBusiness" class="d-flex gap-4"><label><input type="radio" name="postalSame" checked="@(PostalSameAsBusiness == true)" @onchange="() => SetPostalSelection(true)" /> Yes</label><label><input type="radio" name="postalSame" checked="@(PostalSameAsBusiness == false)" @onchange="() => SetPostalSelection(false)" /> No</label></div></fieldset></div>
                @if (PostalSameAsBusiness == false) { <div class="col-12">@FieldLabel("postalAddressLine1", "Postal Address Line 1")<input id="postalAddressLine1" class="form-control" maxlength="150" @bind="PostalAddressLine1" /></div><div class="col-12"><label class="form-label fw-semibold" for="postalAddressLine2">Postal Address Line 2</label><input id="postalAddressLine2" class="form-control" maxlength="150" @bind="PostalAddressLine2" /></div><div class="col-12 col-md-6">@FieldLabel("postalSuburb", "Suburb")<input id="postalSuburb" class="form-control" maxlength="100" @bind="PostalSuburb" /></div><div class="col-12 col-md-6">@FieldLabel("postalCity", "City / Town")<input id="postalCity" class="form-control" maxlength="100" @bind="PostalCity" /></div><div class="col-12 col-md-4">@FieldLabel("postalPostalCode", "Postal Code")<input id="postalPostalCode" class="form-control" maxlength="12" inputmode="numeric" @bind="PostalPostalCode" /></div> }
            </div>
        </div></div>
    </section>
}

@if (CurrentStep == 4)
{
    <section class="licence-info-step" aria-labelledby="licence-info-heading">
        <div class="licence-info-header"><h4 id="licence-info-heading" class="fw-bold mb-2">Licence-Specific Details</h4><p class="text-muted mb-0">Only questions relevant to @LicenceType are shown.</p></div>
        <div class="card licence-info-card mb-4"><div class="card-body">
            <div class="licence-info-card-heading"><span class="licence-info-card-icon"><PhosphorIcon Name="clipboard-text" /></span><h5 class="mb-0">@LicenceType</h5></div>
            <div class="row g-3">@foreach (var question in SelectedLicence?.Questions ?? []) { <div class="col-12 @(question.Type == QuestionType.Text ? "" : "col-md-6")">@FieldLabel(question.Key, question.Label) @if (question.Type == QuestionType.Text) { <textarea id="@question.Key" class="form-control" rows="2" value="@GetAnswer(question.Key)" @oninput="@(e => SetAnswer(question.Key, e.Value?.ToString()))"></textarea> } else { <select id="@question.Key" class="form-select" value="@GetAnswer(question.Key)" @onchange="@(e => SetAnswer(question.Key, e.Value?.ToString()))"><option value="">Select an option</option>@foreach (var option in question.Options) { <option value="@option">@option</option> }</select> }</div> }</div>
        </div></div>
    </section>
}

@if (CurrentStep == 5)
{
    <section class="supporting-documents-step" aria-labelledby="documents-heading">
        <div class="supporting-documents-header"><h4 id="documents-heading" class="fw-bold mb-2">Supporting Documents</h4><p class="text-muted mb-0">Upload the documents required for @LicenceType. The generated PDF is not a supporting document.</p></div>
        <div class="card supporting-documents-card mb-4"><div class="card-body"><div class="supporting-documents-card-heading"><span class="supporting-documents-card-icon"><PhosphorIcon Name="files" /></span><h5 class="mb-0">Required Documents</h5></div><div class="supporting-document-list">
            @foreach (var requirement in SelectedLicence?.Documents ?? [])
            {
                var selected = SelectedDocuments.FirstOrDefault(document => document.DocumentType == requirement.DocumentType);
                <div class="supporting-document-item"><div class="supporting-document-details"><span class="supporting-document-icon"><PhosphorIcon Name="file-text" /></span><div><h6 class="fw-bold mb-1">@requirement.DocumentType <span class="text-danger">*</span></h6><p class="text-muted mb-0">@requirement.Description</p></div></div><div class="supporting-document-upload"><label class="form-label fw-semibold">Upload @requirement.DocumentType</label><InputFile class="form-control" accept=".pdf,.png,.jpg,.jpeg" disabled="@(ReadingDocumentType == requirement.DocumentType)" OnChange="@(e => HandleFileSelected(e, requirement.DocumentType))" />@if (ReadingDocumentType == requirement.DocumentType) { <div class="mt-2 text-muted" role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Reading document...</div> }@if (selected != null) { <div class="supporting-document-selected-file mt-3"><PhosphorIcon Name="check-circle" CssClass="me-2" /><strong>Selected:</strong> @selected.FileName</div> }</div></div>
            }
        </div></div></div>
    </section>
}

@if (CurrentStep == 6)
{
    <section class="review-submit-step" aria-labelledby="review-heading">
        <div class="review-submit-header"><h4 id="review-heading" class="fw-bold mb-2">Review & Declaration</h4><p class="text-muted mb-0">Verify all information before making the declaration.</p></div>
        <div class="row g-4">
            <div class="col-12 col-lg-6"><div class="card review-submit-card h-100"><div class="card-body"><h5 class="mb-3">Applicant</h5>@ReviewItem("Application Type", ApplicationType)@ReviewItem("Licence Type", LicenceType)@ReviewItem("Applicant Name", FullApplicantName)@ReviewItem("Address", FormattedApplicantAddress)@ReviewItem("Telephone", ApplicantTelephone)@ReviewItem("Email", ApplicantEmail)</div></div></div>
            <div class="col-12 col-lg-6"><div class="card review-submit-card h-100"><div class="card-body"><h5 class="mb-3">Business</h5>@ReviewItem("Business Name", BusinessName)@ReviewItem("Nature", BusinessCategory)@ReviewItem("Place of Business / Trading Address", FormattedPlaceOfBusinessAddress)@ReviewItem("Postal Address", FormattedPostalAddress)@ReviewItem("Responsible Municipality", "Determined automatically on submission")@ReviewItem("Trading Hours", ApplicationEntry.FormatTradingHours(ApplicationEntry.SerializeTradingHours(TradingDays)))</div></div></div>
            <div class="col-12"><div class="card review-submit-card"><div class="card-body"><h5 class="mb-3">@LicenceType Details</h5>@foreach (var question in SelectedLicence?.Questions ?? []) { @ReviewItem(question.Label, GetAnswer(question.Key)) }</div></div></div>
            <div class="col-12"><div class="card review-submit-card"><div class="card-body"><h5 class="mb-3">Supporting Documents</h5>@foreach (var document in SelectedDocuments) { @ReviewItem(document.DocumentType, document.FileName) }</div></div></div>
        </div>
        <div class="card review-submit-card review-consent-card mt-4"><div class="card-body"><h5 class="mb-3">Consent and Declaration</h5><div class="form-check review-consent-check mb-3"><input class="form-check-input" type="checkbox" id="declaration" @bind="DeclarationAccepted" /><label class="form-check-label" for="declaration">I declare that the information supplied is true and correct and that I am authorised to submit this application.</label></div><div class="form-check review-consent-check"><input class="form-check-input" type="checkbox" id="popiaConsent" @bind="PopiaConsentAccepted" /><label class="form-check-label" for="popiaConsent">I consent to the collection and storage of my information for processing this application.</label></div></div></div>
    </section>
}

@if (CurrentStep == 7)
{
    <section class="review-submit-step" aria-labelledby="submit-heading"><div class="card review-submit-card review-submit-summary-card"><div class="card-body text-center py-5"><PhosphorIcon Name="file-pdf" CssClass="ph-icon-lg" /><h4 id="submit-heading" class="fw-bold mt-3">Ready to Submit</h4><p class="text-muted mx-auto" style="max-width:680px">Submitting will save the application, generate the official completed PDF, and route it to the municipality determined from your trading address. Supporting documents remain separate.</p><div class="alert alert-info text-start mt-4 mb-0">After submission, use your dashboard to track progress and download the generated application PDF.</div></div></div></section>
}

</fieldset>
<div class="mt-5 d-flex flex-wrap gap-2">@if (CurrentStep > 1) { <button class="btn btn-outline-secondary" disabled="@IsSubmitting" @onclick="PreviousStep"><PhosphorIcon Name="arrow-left" /> Back</button> } @if (CurrentStep < TotalSteps) { <button class="btn btn-primary" disabled="@IsSubmitting" @onclick="NextStep">Next <PhosphorIcon Name="arrow-right" /></button> } else { <button class="btn btn-success" disabled="@IsSubmitting" aria-busy="@IsSubmitting" @onclick="SubmitApplication">@if (IsSubmitting) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } else { <PhosphorIcon Name="check-circle" /> } @(IsSubmitting ? "Submitting application..." : "Submit Application")</button> }</div>

@code {
    private const int TotalSteps = 7;
    private const long MaxFileSize = 10 * 1024 * 1024;
    private int CurrentStep = 1;
    private bool IsSubmitting, MessageIsError, DeclarationAccepted, PopiaConsentAccepted, ScrollToStep;
    private bool? PostalSameAsBusiness;
    private string? InvalidFieldId;
    private string? ReadingDocumentType;
    private string Message = "", LicenceType = "", ApplicationType = "", ApplicantFirstName = "", ApplicantLastName = "", ApplicantAddressLine1 = "", ApplicantAddressLine2 = "", ApplicantSuburb = "", ApplicantCity = "", ApplicantPostalCode = "", ApplicantTelephone = "", ApplicantEmail = "";
    private string BusinessName = "", RegistrationNumber = "", TaxNumber = "", BusinessCategory = "", ContactPerson = "", BusinessTelephone = "", BusinessEmail = "";
    private string PlaceOfBusinessAddressLine1 = "", PlaceOfBusinessAddressLine2 = "", PlaceOfBusinessSuburb = "", PlaceOfBusinessCity = "", PlaceOfBusinessPostalCode = "", PostalAddressLine1 = "", PostalAddressLine2 = "", PostalSuburb = "", PostalCity = "", PostalPostalCode = "";
    private readonly List<TradingDay> TradingDays = ApplicationEntry.Days.Select(day => new TradingDay { Day = day }).ToList();
    private readonly Dictionary<string, string> LicenceAnswers = new();
    private readonly List<SelectedDocument> SelectedDocuments = new();

    private LicenceDefinition? SelectedLicence => LicenceApplicationCatalog.Find(LicenceType);
    private string FormattedPlaceOfBusinessAddress => string.Join(", ", new[] { PlaceOfBusinessAddressLine1, PlaceOfBusinessAddressLine2, PlaceOfBusinessSuburb, PlaceOfBusinessCity, PlaceOfBusinessPostalCode }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private string FullApplicantName => $"{ApplicantFirstName.Trim()} {ApplicantLastName.Trim()}".Trim();
    private string FormattedApplicantAddress => ApplicationEntry.FormatAddress(ApplicantAddressLine1, ApplicantAddressLine2, ApplicantSuburb, ApplicantCity, ApplicantPostalCode);
    private string FormattedPostalAddress => PostalSameAsBusiness == true ? FormattedPlaceOfBusinessAddress : ApplicationEntry.FormatAddress(PostalAddressLine1, PostalAddressLine2, PostalSuburb, PostalCity, PostalPostalCode);
    private string StepTitle => CurrentStep switch { 1 => "Licence Type", 2 => "Applicant Details", 3 => "Business Details", 4 => "Licence-Specific Details", 5 => "Supporting Documents", 6 => "Review & Declaration", 7 => "Submit", _ => "" };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(state.User);
        if (user != null) { var split = user.FullName.Trim().Split(' ', 2, StringSplitOptions.RemoveEmptyEntries); ApplicantFirstName = split.ElementAtOrDefault(0) ?? ""; ApplicantLastName = split.ElementAtOrDefault(1) ?? ""; ApplicantEmail = user.Email ?? ""; ApplicantTelephone = user.PhoneNumber ?? ""; }
    }

    private void SelectLicence(LicenceDefinition definition)
    {
        if (LicenceType == definition.Name) return;
        LicenceType = definition.Name; LicenceAnswers.Clear(); SelectedDocuments.Clear();
        foreach (var question in definition.Questions) LicenceAnswers[question.Key] = "";
    }

    private string GetAnswer(string key) => LicenceAnswers.GetValueOrDefault(key, "");
    private void SetAnswer(string key, string? value) => LicenceAnswers[key] = value?.Trim() ?? "";
    private void NextStep() { if (IsSubmitting) return; Message = ""; InvalidFieldId = null; if (ValidateStep(CurrentStep)) { CurrentStep++; ScrollToStep = true; } }
    private void PreviousStep() { if (IsSubmitting) return; Message = ""; InvalidFieldId = null; CurrentStep--; ScrollToStep = true; }
    private void SetPostalSelection(bool same) { PostalSameAsBusiness = same; if (same) { PostalAddressLine1 = PostalAddressLine2 = PostalSuburb = PostalCity = PostalPostalCode = ""; } }
    private static void SetDayStatus(TradingDay day, string? status)
    {
        day.IsOpen = status switch { "open" => true, "closed" => false, _ => null };
        if (day.IsOpen != true) day.OpeningTime = day.ClosingTime = "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ScrollToStep) { ScrollToStep = false; await JS.InvokeVoidAsync("applicationWizard.scrollToStep"); }
        else if (InvalidFieldId is { } id) { InvalidFieldId = null; await JS.InvokeVoidAsync("applicationWizard.focusInvalid", id); }
    }

    private bool ValidateStep(int step)
    {
        var error = step switch
        {
            1 when SelectedLicence == null => "Please select a licence type before continuing.",
            2 when ApplicationEntry.ValidateName(ApplicantFirstName, ApplicantLastName) is { } nameError => nameError,
            2 when AnyBlank(ApplicationType, ApplicantAddressLine1, ApplicantSuburb, ApplicantCity, ApplicantPostalCode, ApplicantTelephone, ApplicantEmail) => "Please complete all required applicant details.",
            2 when ApplicantFirstName.Trim().Length > 100 || ApplicantLastName.Trim().Length > 100 || ApplicantAddressLine1.Trim().Length > 150 || ApplicantAddressLine2.Trim().Length > 150 || ApplicantSuburb.Trim().Length > 100 || ApplicantCity.Trim().Length > 100 || ApplicantPostalCode.Trim().Length > 12 => "One or more applicant fields exceed the allowed length.",
            3 when AnyBlank(BusinessName, RegistrationNumber, TaxNumber, BusinessCategory, ContactPerson, BusinessTelephone, BusinessEmail, PlaceOfBusinessAddressLine1, PlaceOfBusinessSuburb, PlaceOfBusinessCity, PlaceOfBusinessPostalCode) => "Please complete all required business and trading address details.",
            3 when !ApplicationEntry.ValidRegistration(RegistrationNumber) => "Company Registration Number must use the format YYYY/NNNNNN/XX.",
            3 when !ApplicationEntry.ValidTaxNumber(TaxNumber) => "Tax Number must contain exactly 10 digits.",
            3 when ApplicationEntry.ValidateTradingHours(TradingDays) is { } hoursError => hoursError,
            3 when ApplicationEntry.ValidatePostalAddress(PostalSameAsBusiness, PostalAddressLine1, PostalSuburb, PostalCity, PostalPostalCode) is { } postalError => postalError,
            3 when PostalSameAsBusiness == false && (PostalAddressLine1.Trim().Length > 150 || PostalAddressLine2.Trim().Length > 150 || PostalSuburb.Trim().Length > 100 || PostalCity.Trim().Length > 100 || PostalPostalCode.Trim().Length > 12) => "One or more postal address fields exceed the allowed length.",
            4 when SelectedLicence?.Questions.Any(question => question.Required && string.IsNullOrWhiteSpace(GetAnswer(question.Key))) == true => "Please answer every required licence-specific question.",
            5 when SelectedLicence?.Documents.Any(requirement => requirement.Required && !SelectedDocuments.Any(document => document.DocumentType == requirement.DocumentType)) == true => "Please upload every required supporting document.",
            6 when !DeclarationAccepted || !PopiaConsentAccepted => "Please accept both the declaration and POPIA consent before continuing.",
            _ => null
        };
        if (error == null) return true;
        SetError(error);
        InvalidFieldId = step switch
        {
            1 => "licence-type-heading",
            2 => FirstBlank(("applicationType", ApplicationType), ("applicantFirstName", ApplicantFirstName), ("applicantLastName", ApplicantLastName), ("applicantAddressLine1", ApplicantAddressLine1), ("applicantSuburb", ApplicantSuburb), ("applicantCity", ApplicantCity), ("applicantPostalCode", ApplicantPostalCode), ("applicantTelephone", ApplicantTelephone), ("applicantEmail", ApplicantEmail)),
            3 => FirstBlank(("businessName", BusinessName), ("registrationNumber", RegistrationNumber), ("taxNumber", TaxNumber), ("businessCategory", BusinessCategory), ("contactPerson", ContactPerson), ("businessTelephone", BusinessTelephone), ("businessEmail", BusinessEmail), ("addressLine1", PlaceOfBusinessAddressLine1), ("suburb", PlaceOfBusinessSuburb), ("city", PlaceOfBusinessCity), ("postalCode", PlaceOfBusinessPostalCode)) ?? (error.Contains("Registration") ? "registrationNumber" : error.Contains("Tax Number") ? "taxNumber" : error.Contains("trading", StringComparison.OrdinalIgnoreCase) || error.Contains("Closing Time") || error.Contains("opening and closing") || error.Contains("Open or Closed") || error.Contains("HH:mm") ? "tradingHours" : PostalSameAsBusiness == null ? "postalSameAsBusiness" : "postalAddressLine1"),
            4 => SelectedLicence?.Questions.FirstOrDefault(q => q.Required && string.IsNullOrWhiteSpace(GetAnswer(q.Key)))?.Key,
            6 => !DeclarationAccepted ? "declaration" : "popiaConsent",
            _ => null
        };
        return false;
    }

    private static bool AnyBlank(params string[] values) => values.Any(string.IsNullOrWhiteSpace);
    private static string? FirstBlank(params (string Id, string Value)[] fields) => fields.FirstOrDefault(field => string.IsNullOrWhiteSpace(field.Value)).Id;
    private void SetError(string message) { Message = message; MessageIsError = true; }

    private async Task HandleFileSelected(InputFileChangeEventArgs args, string documentType)
    {
        if (ReadingDocumentType == documentType || IsSubmitting) return;
        Message = ""; var file = args.File; var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (extension is not (".pdf" or ".png" or ".jpg" or ".jpeg")) { SetError("Supporting documents must be PDF, PNG or JPEG files."); return; }
        ReadingDocumentType = documentType;
        try { using var stream = new MemoryStream(); await file.OpenReadStream(MaxFileSize).CopyToAsync(stream); SelectedDocuments.RemoveAll(item => item.DocumentType == documentType); SelectedDocuments.Add(new(documentType, Path.GetFileName(file.Name), stream.ToArray())); }
        catch (IOException) { SetError("The selected document exceeds the 10 MB file limit."); }
        finally { ReadingDocumentType = null; }
    }

    private async Task SubmitApplication()
    {
        if (IsSubmitting) return;
        Message = ""; for (var step = 1; step <= 6; step++) if (!ValidateStep(step)) { CurrentStep = step; StateHasChanged(); return; }
        IsSubmitting = true;

        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var user = await UserManager.GetUserAsync(state.User);
            if (user == null) { SetError("You must be logged in to submit an application."); return; }
            var address = new TradingAddress(PlaceOfBusinessAddressLine1.Trim(), PlaceOfBusinessAddressLine2.Trim(), PlaceOfBusinessSuburb.Trim(), PlaceOfBusinessCity.Trim(), PlaceOfBusinessPostalCode.Trim());
            MessageIsError = false; Message = "Checking your trading address...";
            var routing = await RoutingService.ResolveAsync(address);
            if (!routing.Success)
            {
                if (routing.Failure != RoutingFailure.Unavailable) CurrentStep = 3;
                SetError(routing.Message);
                return;
            }
            Message = "Saving application and generating PDF...";
            StateHasChanged();
            await using var transaction = await Db.Database.BeginTransactionAsync();
            BusinessLicensing_Practice.Models.Municipality participatingMunicipality;
            try
            {
                participatingMunicipality = await MunicipalityManagementService.RequireActiveRoutingAsync(Db, routing.Municipality!);
            }
            catch (System.ComponentModel.DataAnnotations.ValidationException error)
            {
                SetError(error.Message);
                return;
            }
            var now = DateTime.Now; var count = await Db.Applications.CountAsync(item => item.DateSubmitted.Year == now.Year);
            var application = new Application
            {
                ApplicationNumber = $"APP-{now.Year}-{count + 1:D3}", BusinessName = BusinessName.Trim(), RegistrationNumber = RegistrationNumber.Trim(), TaxNumber = TaxNumber.Trim(), BusinessCategory = BusinessCategory.Trim(),
                PlaceOfBusinessAddress = address.Formatted, PlaceOfBusinessAddressLine1 = address.Line1, PlaceOfBusinessAddressLine2 = address.Line2, PlaceOfBusinessSuburb = address.Suburb, PlaceOfBusinessCity = address.City, PlaceOfBusinessPostalCode = address.PostalCode, LicenceType = LicenceType, Municipality = participatingMunicipality.Name,
                PopiaConsentAccepted = true, Status = "Submitted", DateSubmitted = now, UserId = user.Id,
                Details = new ApplicationDetails { ApplicationType = ApplicationType, ApplicantFirstName = ApplicantFirstName.Trim(), ApplicantLastName = ApplicantLastName.Trim(), ApplicantAddressLine1 = ApplicantAddressLine1.Trim(), ApplicantAddressLine2 = ApplicantAddressLine2.Trim(), ApplicantSuburb = ApplicantSuburb.Trim(), ApplicantCity = ApplicantCity.Trim(), ApplicantPostalCode = ApplicantPostalCode.Trim(), ApplicantTelephone = ApplicantTelephone.Trim(), ApplicantEmail = ApplicantEmail.Trim(), PostalAddressSameAsBusiness = PostalSameAsBusiness, PostalAddressLine1 = PostalSameAsBusiness == false ? PostalAddressLine1.Trim() : null, PostalAddressLine2 = PostalSameAsBusiness == false ? PostalAddressLine2.Trim() : null, PostalSuburb = PostalSameAsBusiness == false ? PostalSuburb.Trim() : null, PostalCity = PostalSameAsBusiness == false ? PostalCity.Trim() : null, PostalPostalCode = PostalSameAsBusiness == false ? PostalPostalCode.Trim() : null, ContactPerson = ContactPerson.Trim(), BusinessTelephone = BusinessTelephone.Trim(), BusinessEmail = BusinessEmail.Trim(), TradingHours = ApplicationEntry.SerializeTradingHours(TradingDays), LicenceSpecificDetailsJson = JsonSerializer.Serialize(LicenceAnswers), DeclarationAccepted = true, DeclarationAcceptedAt = now }
            };
            foreach (var selected in SelectedDocuments) { var reference = await Uploads.SaveAsync(selected.FileName, selected.FileBytes); application.Documents.Add(new ApplicationDocument { DocumentType = selected.DocumentType, FileName = selected.FileName, FilePath = reference }); }
            Db.Applications.Add(application); await Db.SaveChangesAsync();
            application.ApplicationFormFileName = $"{application.ApplicationNumber}-Official-Application.pdf";
            application.ApplicationFormFilePath = await FileService.SaveGeneratedPdfAsync(application.Id, application.ApplicationFormFileName, PdfService.Generate(application));
            await Db.SaveChangesAsync(); await transaction.CommitAsync();
            MessageIsError = false; Message = "Application submitted successfully. Your official PDF has been generated."; Nav.NavigateTo($"/tracking/{application.Id}");
        }
        catch (Exception) { SetError("The application could not be submitted. No database changes were saved. Please try again."); }
        finally { IsSubmitting = false; }
    }

    private RenderFragment FieldLabel(string id, string label) => builder =>
