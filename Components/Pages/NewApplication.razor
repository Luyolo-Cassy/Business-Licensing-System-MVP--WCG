@page "/new-application"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "BusinessOwner")]

@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using BusinessLicensing_Practice.Data
@using BusinessLicensing_Practice.Models
@using BusinessLicensing_Practice.Services

@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject IWebHostEnvironment Environment
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ApplicationPdfService PdfService
@inject ApplicationFileService FileService
@inject GeminiDocumentValidationService GeminiValidator

<h3 class="fw-bold mb-4">New Business Licence Application</h3>
<div class="progress mb-3" aria-label="Application progress">
    <div class="progress-bar bg-success" role="progressbar" style="width:@((CurrentStep * 100) / TotalSteps)%" aria-valuenow="@CurrentStep" aria-valuemin="1" aria-valuemax="@TotalSteps">Step @CurrentStep of @TotalSteps</div>
</div>
<div class="mb-4"><span class="badge bg-primary">Step @CurrentStep of @TotalSteps</span><span class="ms-2 text-muted">@StepTitle</span></div>

@if (CurrentStep == 1)
{
    <section class="licence-type-step" aria-labelledby="licence-type-heading">
        <div class="licence-type-header"><h4 id="licence-type-heading" class="fw-bold mb-2">Select Licence Type</h4><p class="text-muted mb-0">Your selection determines the questions and supporting documents required.</p></div>
        <div class="row g-4" role="radiogroup" aria-labelledby="licence-type-heading">
            @foreach (var option in LicenceApplicationCatalog.Licences)
            {
                var selected = LicenceType == option.Name;
                <div class="col-12 col-md-6 col-xl-4"><label class="licence-type-card card h-100 @(selected ? "is-selected" : "")">
                    <span class="visually-hidden">@option.Name</span><div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-start justify-content-between gap-3 mb-3"><span class="licence-type-icon"><PhosphorIcon Name="@option.IconClass" /></span><input class="form-check-input licence-type-radio" type="radio" name="licenceType" value="@option.Name" checked="@selected" @onchange="@(() => SelectLicence(option))" /></div>
                        <h5 class="licence-type-title">@option.Name</h5><p class="licence-type-description">@option.Description</p>
                        <div class="licence-type-state mt-auto">@(selected ? "Selected" : "Select licence")</div>
                    </div>
                </label></div>
            }
        </div>
    </section>
}

@if (CurrentStep == 2)
{
    <section class="business-info-step" aria-labelledby="applicant-heading">
        <div class="business-info-header"><h4 id="applicant-heading" class="fw-bold mb-2">Applicant Details</h4><p class="text-muted mb-0">Provide the applicant or authorised representative details for the official record.</p></div>
        <div class="card business-info-card mb-4"><div class="card-body">
            <div class="business-info-card-heading"><span class="business-info-card-icon"><PhosphorIcon Name="user" /></span><h5 class="mb-0">Application Information</h5></div>
            <div class="row g-3">
                <div class="col-12 col-md-6">@FieldLabel("applicationType", "Application Type")<select id="applicationType" class="form-select" @bind="ApplicationType"><option value="">Select application type</option><option>New application</option><option>Renewal</option><option>Amendment</option></select></div>
                <div class="col-12 col-md-6">@FieldLabel("applicantName", "Applicant / Owner / Company Name")<input id="applicantName" class="form-control" @bind="ApplicantName" /></div>
                <div class="col-12">@FieldLabel("applicantAddress", "Applicant Address")<textarea id="applicantAddress" class="form-control" rows="2" @bind="ApplicantAddress"></textarea></div>
                <div class="col-12 col-md-6">@FieldLabel("applicantTelephone", "Telephone Number")<input id="applicantTelephone" class="form-control" type="tel" @bind="ApplicantTelephone" /></div>
                <div class="col-12 col-md-6">@FieldLabel("applicantEmail", "Email Address")<input id="applicantEmail" class="form-control" type="email" @bind="ApplicantEmail" /></div>
            </div>
        </div></div>
    </section>
}

@if (CurrentStep == 3)
{
    <section class="business-info-step" aria-labelledby="business-heading">
        <div class="business-info-header"><h4 id="business-heading" class="fw-bold mb-2">Business Details</h4><p class="text-muted mb-0">Enter the common business and premises information required for the application.</p></div>
        <div class="card business-info-card mb-4"><div class="card-body">
            <div class="business-info-card-heading"><span class="business-info-card-icon"><PhosphorIcon Name="buildings" /></span><h5 class="mb-0">Business Information</h5></div>
            <div class="row g-3">
                <div class="col-12 col-md-6">@FieldLabel("businessName", "Business Name")<input id="businessName" class="form-control" @bind="BusinessName" /></div>
                <div class="col-12 col-md-6">@FieldLabel("registrationNumber", "Registration Number")<input id="registrationNumber" class="form-control" @bind="RegistrationNumber" /></div>
                <div class="col-12 col-md-6">@FieldLabel("taxNumber", "Tax Number")<input id="taxNumber" class="form-control" @bind="TaxNumber" /></div>
                <div class="col-12">@FieldLabel("businessCategory", "Nature of Business")<textarea id="businessCategory" class="form-control" rows="2" @bind="BusinessCategory"></textarea></div>
                <div class="col-12 col-md-6">@FieldLabel("contactPerson", "Contact Person")<input id="contactPerson" class="form-control" @bind="ContactPerson" /></div>
                <div class="col-12 col-md-6">@FieldLabel("businessTelephone", "Business Telephone")<input id="businessTelephone" class="form-control" type="tel" @bind="BusinessTelephone" /></div>
                <div class="col-12 col-md-6">@FieldLabel("businessEmail", "Business Email")<input id="businessEmail" class="form-control" type="email" @bind="BusinessEmail" /></div>
                <div class="col-12 col-md-6">@FieldLabel("tradingHours", "Trading Hours")<input id="tradingHours" class="form-control" placeholder="e.g. Monday-Friday 08:00-17:00" @bind="TradingHours" /></div>
            </div>
        </div></div>
        <div class="card business-info-card mb-4"><div class="card-body">
            <div class="business-info-card-heading"><span class="business-info-card-icon"><PhosphorIcon Name="map-pin" /></span><h5 class="mb-0">Business Address and Routing</h5></div>
            <div class="row g-3">
                <div class="col-12">@FieldLabel("addressLine1", "Address Line 1")<input id="addressLine1" class="form-control" @bind="AddressLine1" /></div>
                <div class="col-12"><label class="form-label fw-semibold" for="addressLine2">Address Line 2</label><input id="addressLine2" class="form-control" @bind="AddressLine2" /></div>
                <div class="col-12 col-md-6">@FieldLabel("suburb", "Suburb")<input id="suburb" class="form-control" @bind="Suburb" /></div>
                <div class="col-12 col-md-6">@FieldLabel("city", "Town / City")<input id="city" class="form-control" @bind="City" /></div>
                <div class="col-12 col-md-4">@FieldLabel("postalCode", "Postal Code")<input id="postalCode" class="form-control" @bind="PostalCode" /></div>
                <div class="col-12 col-md-8">@FieldLabel("municipality", "Responsible Municipality")<select id="municipality" class="form-select" @bind="Municipality"><option value="">Select municipality</option>@foreach (var municipality in LicenceApplicationCatalog.Municipalities) { <option value="@municipality">@municipality.Replace(" Municipality", "")</option> }</select></div>
                <div class="col-12">@FieldLabel("postalAddress", "Postal Address")<textarea id="postalAddress" class="form-control" rows="2" @bind="PostalAddress"></textarea></div>
            </div>
        </div></div>
    </section>
}

@if (CurrentStep == 4)
{
    <section class="licence-info-step" aria-labelledby="licence-info-heading">
        <div class="licence-info-header"><h4 id="licence-info-heading" class="fw-bold mb-2">Licence-Specific Details</h4><p class="text-muted mb-0">Only questions relevant to @LicenceType are shown.</p></div>
        <div class="card licence-info-card mb-4"><div class="card-body">
            <div class="licence-info-card-heading"><span class="licence-info-card-icon"><PhosphorIcon Name="clipboard-text" /></span><h5 class="mb-0">@LicenceType</h5></div>
            <div class="row g-3">@foreach (var question in SelectedLicence?.Questions ?? []) { <div class="col-12 @(question.Type == QuestionType.Text ? "" : "col-md-6")">@FieldLabel(question.Key, question.Label) @if (question.Type == QuestionType.Text) { <textarea id="@question.Key" class="form-control" rows="2" value="@GetAnswer(question.Key)" @oninput="@(e => SetAnswer(question.Key, e.Value?.ToString()))"></textarea> } else { <select id="@question.Key" class="form-select" value="@GetAnswer(question.Key)" @onchange="@(e => SetAnswer(question.Key, e.Value?.ToString()))"><option value="">Select an option</option>@foreach (var option in question.Options) { <option value="@option">@option</option> }</select> }</div> }</div>
        </div></div>
    </section>
}

@if (CurrentStep == 5)
{
    <section class="supporting-documents-step" aria-labelledby="documents-heading">
        <div class="supporting-documents-header"><h4 id="documents-heading" class="fw-bold mb-2">Supporting Documents</h4><p class="text-muted mb-0">Upload the documents required for @LicenceType. The generated PDF is not a supporting document.</p></div>
        <div class="card supporting-documents-card mb-4"><div class="card-body"><div class="supporting-documents-card-heading"><span class="supporting-documents-card-icon"><PhosphorIcon Name="files" /></span><h5 class="mb-0">Required Documents</h5></div><div class="supporting-document-list">
            @foreach (var requirement in SelectedLicence?.Documents ?? [])
            {
                var selected = SelectedDocuments.FirstOrDefault(document => document.DocumentType == requirement.DocumentType);
                <div class="supporting-document-item"><div class="supporting-document-details"><span class="supporting-document-icon"><PhosphorIcon Name="file-text" /></span><div><h6 class="fw-bold mb-1">@requirement.DocumentType <span class="text-danger">*</span></h6><p class="text-muted mb-0">@requirement.Description</p></div></div><div class="supporting-document-upload"><label class="form-label fw-semibold">Upload @requirement.DocumentType</label><InputFile class="form-control" accept=".pdf,.png,.jpg,.jpeg" OnChange="@(e => HandleFileSelected(e, requirement.DocumentType))" />@if (selected != null)
{
    <div class="supporting-document-selected-file mt-3">
        <PhosphorIcon Name="check-circle" CssClass="me-2" />
        <strong>Selected:</strong> @selected.FileName
    </div>

    @if (DocumentValidationResults.TryGetValue(requirement.DocumentType, out var validation))
    {
        <div class="ai-validation-card mt-3 @(GetValidationCss(validation.Status))" role="status">
            <div class="d-flex align-items-start gap-3">
                <div class="ai-validation-icon">
                    <PhosphorIcon Name="@GetValidationIcon(validation.Status)" />
                </div>
                <div class="flex-grow-1">
                    <div class="fw-bold">@GetValidationTitle(validation.Status)</div>
                    <div class="mt-1">@validation.Summary</div>

                    @if (!string.IsNullOrWhiteSpace(validation.ExpiryDate))
                    {
                        <div class="small mt-2"><strong>Expiry date:</strong> @validation.ExpiryDate</div>
                    }

                    @if (validation.Issues.Count > 0)
                    {
                        <ul class="small mb-0 mt-2">
                            @foreach (var issue in validation.Issues)
                            {
                                <li><strong>@issue.Type:</strong> @issue.Message</li>
                            }
                        </ul>
                    }
                </div>
                <span class="badge @GetValidationBadge(validation.Status)">
                    @validation.Status
                </span>
            </div>
        </div>
    }
    else if (ValidatingDocumentTypes.Contains(requirement.DocumentType))
    {
        <div class="alert alert-info mt-3 mb-0">
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            AI is checking this document...
        </div>
    }
}</div></div>
            }
        </div></div></div>
    </section>
}

@if (CurrentStep == 6)
{
    <section class="review-submit-step" aria-labelledby="review-heading">
        <div class="review-submit-header"><h4 id="review-heading" class="fw-bold mb-2">Review & Declaration</h4><p class="text-muted mb-0">Verify all information before making the declaration.</p></div>
        <div class="row g-4">
            <div class="col-12 col-lg-6"><div class="card review-submit-card h-100"><div class="card-body"><h5 class="mb-3">Applicant</h5>@ReviewItem("Application Type", ApplicationType)@ReviewItem("Licence Type", LicenceType)@ReviewItem("Applicant Name", ApplicantName)@ReviewItem("Address", ApplicantAddress)@ReviewItem("Telephone", ApplicantTelephone)@ReviewItem("Email", ApplicantEmail)</div></div></div>
            <div class="col-12 col-lg-6"><div class="card review-submit-card h-100"><div class="card-body"><h5 class="mb-3">Business</h5>@ReviewItem("Business Name", BusinessName)@ReviewItem("Nature", BusinessCategory)@ReviewItem("Address", FormattedBusinessAddress)@ReviewItem("Responsible Municipality", Municipality.Replace(" Municipality", ""))@ReviewItem("Trading Hours", TradingHours)</div></div></div>
            <div class="col-12"><div class="card review-submit-card"><div class="card-body"><h5 class="mb-3">@LicenceType Details</h5>@foreach (var question in SelectedLicence?.Questions ?? []) { @ReviewItem(question.Label, GetAnswer(question.Key)) }</div></div></div>
            <div class="col-12"><div class="card review-submit-card"><div class="card-body"><h5 class="mb-3">Supporting Documents</h5>@foreach (var document in SelectedDocuments) { @ReviewItem(document.DocumentType, document.FileName) }</div></div></div>
        </div>
        <div class="card review-submit-card review-consent-card mt-4"><div class="card-body"><h5 class="mb-3">Consent and Declaration</h5><div class="form-check review-consent-check mb-3"><input class="form-check-input" type="checkbox" id="declaration" @bind="DeclarationAccepted" /><label class="form-check-label" for="declaration">I declare that the information supplied is true and correct and that I am authorised to submit this application.</label></div><div class="form-check review-consent-check"><input class="form-check-input" type="checkbox" id="popiaConsent" @bind="PopiaConsentAccepted" /><label class="form-check-label" for="popiaConsent">I consent to the collection and storage of my information for processing this application.</label></div></div></div>
    </section>
}

@if (CurrentStep == 7)
{
    <section class="review-submit-step" aria-labelledby="submit-heading"><div class="card review-submit-card review-submit-summary-card"><div class="card-body text-center py-5"><PhosphorIcon Name="file-pdf" CssClass="ph-icon-lg" /><h4 id="submit-heading" class="fw-bold mt-3">Ready to Submit</h4><p class="text-muted mx-auto" style="max-width:680px">Submitting will save the application, generate the official completed PDF, and route it to <strong>@Municipality</strong>. Supporting documents remain separate.</p><div class="alert alert-info text-start mt-4 mb-0">After submission, use your dashboard to track progress and download the generated application PDF.</div></div></div></section>
}

@if (!string.IsNullOrWhiteSpace(Message)) { <div class="alert @(MessageIsError ? "alert-danger" : "alert-info") mt-3" role="alert">@Message</div> }
<div class="mt-5 d-flex flex-wrap gap-2">@if (CurrentStep > 1) { <button class="btn btn-outline-secondary" disabled="@IsSubmitting" @onclick="PreviousStep"><PhosphorIcon Name="arrow-left" /> Back</button> } @if (CurrentStep < TotalSteps) { <button class="btn btn-primary" @onclick="NextStep">Next <PhosphorIcon Name="arrow-right" /></button> } else { <button class="btn btn-success" disabled="@IsSubmitting" @onclick="SubmitApplication"><PhosphorIcon Name="check-circle" /> @(IsSubmitting ? "Submitting..." : "Submit Application")</button> }</div>

@code {
    private const int TotalSteps = 7;
    private const long MaxFileSize = 10 * 1024 * 1024;
    private int CurrentStep = 1;
    private bool IsSubmitting, MessageIsError, DeclarationAccepted, PopiaConsentAccepted;
    private string Message = "", LicenceType = "", ApplicationType = "", ApplicantName = "", ApplicantAddress = "", ApplicantTelephone = "", ApplicantEmail = "";
    private string BusinessName = "", RegistrationNumber = "", TaxNumber = "", BusinessCategory = "", ContactPerson = "", BusinessTelephone = "", BusinessEmail = "", TradingHours = "";
    private string AddressLine1 = "", AddressLine2 = "", Suburb = "", City = "", PostalCode = "", Municipality = "", PostalAddress = "";
    private readonly Dictionary<string, string> LicenceAnswers = new();
    private readonly List<SelectedDocument> SelectedDocuments = new();
    private readonly Dictionary<string, DocumentValidationResult> DocumentValidationResults = new();
    private readonly HashSet<string> ValidatingDocumentTypes = new();

    private LicenceDefinition? SelectedLicence => LicenceApplicationCatalog.Find(LicenceType);
    private string FormattedBusinessAddress => string.Join(", ", new[] { AddressLine1, AddressLine2, Suburb, City, PostalCode }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private string StepTitle => CurrentStep switch { 1 => "Licence Type", 2 => "Applicant Details", 3 => "Business Details", 4 => "Licence-Specific Details", 5 => "Supporting Documents", 6 => "Review & Declaration", 7 => "Submit", _ => "" };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(state.User);
        if (user != null) { ApplicantName = user.FullName; ApplicantEmail = user.Email ?? ""; ApplicantTelephone = user.PhoneNumber ?? ""; }
    }

    private void SelectLicence(LicenceDefinition definition)
    {
        if (LicenceType == definition.Name) return;
        LicenceType = definition.Name; LicenceAnswers.Clear(); SelectedDocuments.Clear(); DocumentValidationResults.Clear(); ValidatingDocumentTypes.Clear();
        foreach (var question in definition.Questions) LicenceAnswers[question.Key] = "";
    }

    private string GetAnswer(string key) => LicenceAnswers.GetValueOrDefault(key, "");
    private void SetAnswer(string key, string? value) => LicenceAnswers[key] = value?.Trim() ?? "";
    private void NextStep() { Message = ""; if (ValidateStep(CurrentStep)) CurrentStep++; }
    private void PreviousStep() { Message = ""; CurrentStep--; }

    private bool ValidateStep(int step)
    {
        var error = step switch
        {
            1 when SelectedLicence == null => "Please select a licence type before continuing.",
            2 when AnyBlank(ApplicationType, ApplicantName, ApplicantAddress, ApplicantTelephone, ApplicantEmail) => "Please complete all required applicant details.",
            3 when AnyBlank(BusinessName, RegistrationNumber, TaxNumber, BusinessCategory, ContactPerson, BusinessTelephone, BusinessEmail, TradingHours, AddressLine1, Suburb, City, PostalCode, Municipality, PostalAddress) => "Please complete all required business and routing details.",
            4 when SelectedLicence?.Questions.Any(question => question.Required && string.IsNullOrWhiteSpace(GetAnswer(question.Key))) == true => "Please answer every required licence-specific question.",
            5 when SelectedLicence?.Documents.Any(requirement => requirement.Required && !SelectedDocuments.Any(document => document.DocumentType == requirement.DocumentType)) == true => "Please upload every required supporting document.",
            5 when SelectedLicence?.Documents.Any(requirement => requirement.Required &&
                (!DocumentValidationResults.TryGetValue(requirement.DocumentType, out var result) ||
                 result.Status != "PASS")) == true => "Please fix or replace every supporting document that did not pass the AI document check before continuing.",
            6 when !DeclarationAccepted || !PopiaConsentAccepted => "Please accept both the declaration and POPIA consent before continuing.",
            _ => null
        };
        if (error == null) return true;
        SetError(error); return false;
    }

    private static bool AnyBlank(params string[] values) => values.Any(string.IsNullOrWhiteSpace);
    private void SetError(string message) { Message = message; MessageIsError = true; }

    private async Task HandleFileSelected(InputFileChangeEventArgs args, string documentType)
    {
        Message = "";
        var file = args.File;
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (extension is not (".pdf" or ".png" or ".jpg" or ".jpeg"))
        {
            SetError("Supporting documents must be PDF, PNG or JPEG files.");
            return;
        }

        try
        {
            using var stream = new MemoryStream();
            await file.OpenReadStream(MaxFileSize).CopyToAsync(stream);

            SelectedDocuments.RemoveAll(item => item.DocumentType == documentType);
            DocumentValidationResults.Remove(documentType);

            var selected = new SelectedDocument(
                documentType,
                Path.GetFileName(file.Name),
                stream.ToArray(),
                GetMimeType(extension));

            SelectedDocuments.Add(selected);

            await ValidateDocumentWithAiAsync(selected);
        }
        catch (IOException)
        {
            SetError("The selected document exceeds the 10 MB file limit.");
        }
        catch (Exception ex)
        {
            SetError($"The document was uploaded, but the AI check could not be completed: {ex.Message}");
        }
    }

    private async Task ValidateDocumentWithAiAsync(SelectedDocument selected)
    {
        var requirement = SelectedLicence?.Documents
            .FirstOrDefault(item => item.DocumentType == selected.DocumentType);

        if (requirement == null)
        {
            SetError("The selected document type is not part of this licence application.");
            return;
        }

        ValidatingDocumentTypes.Add(selected.DocumentType);
        try
        {
            var result = await GeminiValidator.ValidateDocumentAsync(
                selected.FileBytes,
                selected.MimeType,
                selected.DocumentType,
                requirement.Description,
                LicenceType,
                BusinessName,
                RegistrationNumber);

            DocumentValidationResults[selected.DocumentType] = result;

            if (result.Status == "PASS")
            {
                MessageIsError = false;
                Message = $"{selected.DocumentType} passed the AI document check.";
            }
            else
            {
                MessageIsError = true;
                Message = $"{selected.DocumentType} needs attention. Please review the feedback below.";
            }
        }
        finally
        {
            ValidatingDocumentTypes.Remove(selected.DocumentType);
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string GetMimeType(string extension) => extension switch
    {
        ".pdf" => "application/pdf",
        ".png" => "image/png",
        ".jpg" or ".jpeg" => "image/jpeg",
        _ => "application/octet-stream"
    };

    private static string GetValidationCss(string status) => status switch
    {
        "PASS" => "ai-validation-pass",
        "FAIL" => "ai-validation-fail",
        _ => "ai-validation-review"
    };

    private static string GetValidationBadge(string status) => status switch
    {
        "PASS" => "bg-success",
        "FAIL" => "bg-danger",
        _ => "bg-warning text-dark"
    };

    private static string GetValidationIcon(string status) => status switch
    {
        "PASS" => "check-circle",
        "FAIL" => "x-circle",
        _ => "warning"
    };

    private static string GetValidationTitle(string status) => status switch
    {
        "PASS" => "Document appears valid",
        "FAIL" => "Document does not meet the requirement",
        _ => "Document needs review"
    };

    private async Task SubmitApplication()
    {
        Message = ""; for (var step = 1; step <= 6; step++) if (!ValidateStep(step)) { CurrentStep = step; return; }
        if (IsSubmitting) return; IsSubmitting = true;
        await using var transaction = await Db.Database.BeginTransactionAsync();
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var user = await UserManager.GetUserAsync(state.User);
            if (user == null) { SetError("You must be logged in to submit an application."); return; }
            var now = DateTime.Now; var count = await Db.Applications.CountAsync(item => item.DateSubmitted.Year == now.Year);
            var application = new Application
            {
                ApplicationNumber = $"APP-{now.Year}-{count + 1:D3}", BusinessName = BusinessName.Trim(), RegistrationNumber = RegistrationNumber.Trim(), TaxNumber = TaxNumber.Trim(), BusinessCategory = BusinessCategory.Trim(),
                BusinessAddress = FormattedBusinessAddress, AddressLine1 = AddressLine1.Trim(), AddressLine2 = AddressLine2.Trim(), Suburb = Suburb.Trim(), City = City.Trim(), PostalCode = PostalCode.Trim(), LicenceType = LicenceType, Municipality = Municipality,
                PopiaConsentAccepted = true, Status = "Submitted", DateSubmitted = now, UserId = user.Id,
                Details = new ApplicationDetails { ApplicationType = ApplicationType, ApplicantName = ApplicantName.Trim(), ApplicantAddress = ApplicantAddress.Trim(), ApplicantTelephone = ApplicantTelephone.Trim(), ApplicantEmail = ApplicantEmail.Trim(), PostalAddress = PostalAddress.Trim(), ContactPerson = ContactPerson.Trim(), BusinessTelephone = BusinessTelephone.Trim(), BusinessEmail = BusinessEmail.Trim(), TradingHours = TradingHours.Trim(), LicenceSpecificDetailsJson = JsonSerializer.Serialize(LicenceAnswers), DeclarationAccepted = true, DeclarationAcceptedAt = now }
            };
            var uploads = Path.Combine(Environment.WebRootPath ?? "wwwroot", "uploads"); Directory.CreateDirectory(uploads);
            foreach (var selected in SelectedDocuments) { var storedName = $"{Guid.NewGuid():N}{Path.GetExtension(selected.FileName).ToLowerInvariant()}"; await File.WriteAllBytesAsync(Path.Combine(uploads, storedName), selected.FileBytes); application.Documents.Add(new ApplicationDocument { DocumentType = selected.DocumentType, FileName = selected.FileName, FilePath = $"/uploads/{storedName}" }); }
            Db.Applications.Add(application); await Db.SaveChangesAsync();
            application.ApplicationFormFileName = $"{application.ApplicationNumber}-Official-Application.pdf";
            application.ApplicationFormFilePath = await FileService.SaveGeneratedPdfAsync(application.Id, application.ApplicationFormFileName, PdfService.Generate(application));
            await Db.SaveChangesAsync(); await transaction.CommitAsync();
            MessageIsError = false; Message = "Application submitted successfully. Your official PDF has been generated."; Nav.NavigateTo($"/tracking/{application.Id}");
        }
        catch (Exception) { await transaction.RollbackAsync(); SetError("The application could not be submitted. No database changes were saved. Please try again."); }
        finally { IsSubmitting = false; }
    }

    private RenderFragment FieldLabel(string id, string label) => builder =>
    {
        builder.OpenElement(0, "label"); builder.AddAttribute(1, "class", "form-label fw-semibold"); builder.AddAttribute(2, "for", id);
        builder.AddContent(3, label + " "); builder.OpenElement(4, "span"); builder.AddAttribute(5, "class", "text-danger"); builder.AddContent(6, "*"); builder.CloseElement(); builder.CloseElement();
    };
    private RenderFragment ReviewItem(string label, string? value) => builder =>
    {
        builder.OpenElement(0, "div"); builder.AddAttribute(1, "class", "review-item");
        builder.OpenElement(2, "span"); builder.AddAttribute(3, "class", "review-label"); builder.AddContent(4, label + ":"); builder.CloseElement();
        builder.OpenElement(5, "span"); builder.AddAttribute(6, "class", "review-value"); builder.AddContent(7, string.IsNullOrWhiteSpace(value) ? "Not provided" : value); builder.CloseElement(); builder.CloseElement();
    };
    private sealed record SelectedDocument(string DocumentType, string FileName, byte[] FileBytes, string MimeType);
}
