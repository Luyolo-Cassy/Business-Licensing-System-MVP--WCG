@page "/new-application"
@page "/applications/{CorrectionApplicationId:int}/edit"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "BusinessOwner")]

@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using BusinessLicensing_Practice.Data
@using BusinessLicensing_Practice.Models
@using BusinessLicensing_Practice.Services

@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject IWebHostEnvironment Environment
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ApplicationPdfService PdfService
@inject ApplicationFileService FileService
@inject ProtectedUploadService Uploads
@inject MunicipalRoutingService RoutingService
@inject AiSettingsService AiSettings
@inject AiDocumentValidationPolicy AiValidation
@inject IApplicationNotificationService Notifications
@inject ApplicationDraftService Drafts
@inject ApplicationCorrectionService Corrections
@inject ILogger<NewApplication> Logger
@inject IJSRuntime JS

@if (ShowExistingDraftChoice)
{
    <section class="card border-primary mb-4" aria-labelledby="existing-draft-heading"><div class="card-body">
        <h3 id="existing-draft-heading" class="fw-bold">You have an application in progress</h3>
        <p>Continue your saved application, or permanently discard it before starting a new one.</p>
        <dl class="row mb-3"><dt class="col-sm-3">Licence type</dt><dd class="col-sm-9">@DisplayDraftValue(ExistingDraftSummary?.LicenceType)</dd><dt class="col-sm-3">Business name</dt><dd class="col-sm-9">@DisplayDraftValue(ExistingDraftSummary?.BusinessName)</dd><dt class="col-sm-3">Progress</dt><dd class="col-sm-9">Step @ExistingDraftSummary?.CurrentStep of @TotalSteps</dd></dl>
        <div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" @onclick="ContinueExistingDraft"><PhosphorIcon Name="arrow-right" /> Continue application</button><button class="btn btn-outline-danger" @onclick="() => ShowDeleteConfirmation = true">Discard draft and start new application</button></div>
    </div></section>
}
else
{
<div id="application-wizard-top"><h3 class="fw-bold mb-4">@(IsCorrectionMode ? $"Edit Application {CorrectionApplicationNumber}" : "New Business Licence Application")</h3></div>
@if (IsCorrectionMode)
{
    <div class="alert alert-warning mb-4" role="status"><h4 class="h5">Additional information requested</h4><p class="mb-1" style="white-space:pre-wrap">@CorrectionRequest</p><small>Requested @CorrectionRequestedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small><p class="mb-0 mt-2">Update the requested information or documents, review the declaration, and resubmit this same application.</p></div>
}
<nav class="wizard-progress mb-4" aria-label="Application progress">
    <p class="wizard-progress-summary">Step @CurrentStep of @TotalSteps: <strong>@StepTitle</strong></p>
    <ol class="wizard-progress-list">
        @foreach (var step in WizardSteps)
        {
            var state = step.Number < CurrentStep ? "completed" : step.Number == CurrentStep ? "current" : "upcoming";
            <li class="wizard-progress-step @state" aria-current="@(step.Number == CurrentStep ? "step" : null)">
                <span class="wizard-progress-marker" aria-hidden="true">
                    @if (step.Number < CurrentStep) { <PhosphorIcon Name="check" /> } else { @step.Number }
                </span>
                <span class="wizard-progress-label"><span class="visually-hidden">Step @step.Number of @TotalSteps. @ProgressStateLabel(state): </span>@step.Label</span>
            </li>
        }
    </ol>
</nav>

@if (!string.IsNullOrWhiteSpace(Message)) { <div class="alert @(MessageIsError ? "alert-danger" : "alert-info") mb-3" role="@(MessageIsError ? "alert" : "status")" aria-live="polite">@Message</div> }
<fieldset class="application-fields wizard-step-enter" @key="CurrentStep" disabled="@IsBusy" aria-busy="@IsBusy" @oninput="DraftChanged" @onchange="DraftChanged">
@if (CurrentStep == 1)
{
    <section class="licence-type-step" aria-labelledby="licence-type-heading">
        <div class="licence-type-header"><h4 id="licence-type-heading" class="fw-bold mb-2">Select Licence Type</h4><p class="text-muted mb-0">Your selection determines the questions and supporting documents required.</p></div>
        <div class="row g-4" role="radiogroup" aria-labelledby="licence-type-heading">
            @foreach (var option in LicenceApplicationCatalog.Licences)
            {
                var selected = LicenceType == option.Name;
                <div class="col-12 col-md-6 col-xl-4"><label class="licence-type-card card h-100 @(selected ? "is-selected" : "")">
                    <span class="visually-hidden">@option.Name</span><div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-start justify-content-between gap-3 mb-3"><span class="licence-type-icon"><PhosphorIcon Name="@option.IconClass" /></span><input class="form-check-input licence-type-radio" type="radio" name="licenceType" value="@option.Name" checked="@selected" disabled="@IsCorrectionMode" @onchange="@(() => SelectLicence(option))" /></div>
                        <h5 class="licence-type-title">@option.Name</h5><p class="licence-type-description">@option.Description</p>
                        <div class="licence-type-state mt-auto">@(selected ? "Selected" : "Select licence")</div>
                    </div>
                </label></div>
            }
        </div>
    </section>
}

@if (CurrentStep == 2)
{
    <section class="business-info-step" aria-labelledby="applicant-heading">
        <div class="business-info-header"><h4 id="applicant-heading" class="fw-bold mb-2">Applicant Details</h4><p class="text-muted mb-0">Provide the applicant or authorised representative details for the official record.</p></div>
        <div class="card business-info-card mb-4"><div class="card-body">
            <div class="business-info-card-heading"><span class="business-info-card-icon"><PhosphorIcon Name="user" /></span><h5 class="mb-0">Application Information</h5></div>
            <div class="row g-3">
                <div class="col-12 col-md-6">@FieldLabel("applicationType", "Application Type")<select id="applicationType" class="form-select" @bind="ApplicationType"><option value="">Select application type</option>@foreach (var applicationType in ApplicationEntry.ApplicationTypes) { <option value="@applicationType">@applicationType</option> }</select></div>
                <div class="col-12 col-md-6">@FieldLabel("applicantFirstName", "First Name")<input id="applicantFirstName" class="form-control" maxlength="100" autocomplete="given-name" @bind="ApplicantFirstName" @bind:event="oninput" /></div>
                <div class="col-12 col-md-6">@FieldLabel("applicantLastName", "Last Name")<input id="applicantLastName" class="form-control" maxlength="100" autocomplete="family-name" @bind="ApplicantLastName" @bind:event="oninput" /></div>
                <div class="col-12">@FieldLabel("applicantAddressLine1", "Address Line 1")<input id="applicantAddressLine1" class="form-control" maxlength="150" autocomplete="address-line1" @bind="ApplicantAddressLine1" @bind:event="oninput" /></div>
                <div class="col-12"><label class="form-label fw-semibold" for="applicantAddressLine2">Address Line 2</label><input id="applicantAddressLine2" class="form-control" maxlength="150" autocomplete="address-line2" @bind="ApplicantAddressLine2" @bind:event="oninput" /></div>
                <div class="col-12 col-md-6">@FieldLabel("applicantSuburb", "Suburb")<input id="applicantSuburb" class="form-control" maxlength="100" @bind="ApplicantSuburb" @bind:event="oninput" /></div>
                <div class="col-12 col-md-6">@FieldLabel("applicantCity", "City / Town")<input id="applicantCity" class="form-control" maxlength="100" autocomplete="address-level2" @bind="ApplicantCity" @bind:event="oninput" /></div>
                <div class="col-12 col-md-4">@FieldLabel("applicantPostalCode", "Postal Code")<input id="applicantPostalCode" class="form-control" maxlength="4" inputmode="numeric" autocomplete="postal-code" @bind="ApplicantPostalCode" @bind:event="oninput" /></div>
                <div class="col-12 col-md-6">@FieldLabel("applicantTelephone", "Telephone Number")<input id="applicantTelephone" class="form-control" type="tel" maxlength="@ApplicationEntry.MaxTelephoneLength" @bind="ApplicantTelephone" @bind:event="oninput" /></div>
                <div class="col-12 col-md-6">@FieldLabel("applicantEmail", "Email Address")<input id="applicantEmail" class="form-control" type="email" maxlength="@ApplicationEntry.MaxEmailLength" @bind="ApplicantEmail" @bind:event="oninput" /></div>
            </div>
        </div></div>
    </section>
}

@if (CurrentStep == 3)
{
    <section class="business-info-step" aria-labelledby="business-heading">
        <div class="business-info-header"><h4 id="business-heading" class="fw-bold mb-2">Business Details</h4><p class="text-muted mb-0">Enter the common business and premises information required for the application.</p></div>
        <div class="card business-info-card mb-4"><div class="card-body">
            <div class="business-info-card-heading"><span class="business-info-card-icon"><PhosphorIcon Name="buildings" /></span><h5 class="mb-0">Business Information</h5></div>
            <div class="row g-3">
                <div class="col-12 col-md-6">@FieldLabel("businessName", "Business Name")<input id="businessName" class="form-control" @bind="BusinessName" @bind:event="oninput" /></div>
                <div class="col-12 col-md-6">@FieldLabel("registrationNumber", "Company Registration Number")<input id="registrationNumber" class="form-control" maxlength="14" aria-describedby="registrationHelp" @bind="RegistrationNumber" @bind:event="oninput" /><div id="registrationHelp" class="form-text">Format: YYYY/NNNNNN/XX</div></div>
                <div class="col-12 col-md-6">@FieldLabel("taxNumber", "Tax Number")<input id="taxNumber" class="form-control" type="text" inputmode="numeric" maxlength="10" aria-describedby="taxHelp" @bind="TaxNumber" @bind:event="oninput" /><div id="taxHelp" class="form-text">Enter the 10-digit tax reference number.</div></div>
                <div class="col-12">@FieldLabel("businessCategory", "Nature of Business")<textarea id="businessCategory" class="form-control" rows="2" @bind="BusinessCategory" @bind:event="oninput"></textarea></div>
                <div class="col-12 col-md-6">@FieldLabel("contactPerson", "Contact Person")<input id="contactPerson" class="form-control" @bind="ContactPerson" @bind:event="oninput" /></div>
                <div class="col-12 col-md-6">@FieldLabel("businessTelephone", "Business Telephone")<input id="businessTelephone" class="form-control" type="tel" maxlength="@ApplicationEntry.MaxTelephoneLength" @bind="BusinessTelephone" @bind:event="oninput" /></div>
                <div class="col-12 col-md-6">@FieldLabel("businessEmail", "Business Email")<input id="businessEmail" class="form-control" type="email" maxlength="@ApplicationEntry.MaxEmailLength" @bind="BusinessEmail" @bind:event="oninput" /></div>
                <div class="col-12"><div class="form-label fw-semibold">Trading Hours</div><p class="form-text mt-0">For Open days, enter 24-hour times as HH:mm (for example 08:00 and 17:00).</p><div class="trading-hours-list" id="tradingHours">@foreach (var day in TradingDays) { <div class="trading-hours-row" @key="day.Day"><strong>@day.Day</strong><select class="form-select" aria-label="@day.Day trading status" value="@(day.IsOpen == true ? "open" : day.IsOpen == false ? "closed" : "")" @onchange="e => SetDayStatus(day, e.Value?.ToString())"><option value="">Select status</option><option value="open">Open</option><option value="closed">Closed</option></select>@if (day.IsOpen == true) { <label>Opening Time <input class="form-control" type="text" placeholder="HH:mm" maxlength="5" autocomplete="off" @bind="day.OpeningTime" @bind:event="oninput" /></label><label>Closing Time <input class="form-control" type="text" placeholder="HH:mm" maxlength="5" autocomplete="off" @bind="day.ClosingTime" @bind:event="oninput" /></label> } else if (day.IsOpen == false) { <span class="text-muted">Closed</span> }</div> }</div></div>
                <div class="col-12"><fieldset id="publicHolidayTrading" tabindex="-1"><legend class="form-label fw-semibold fs-6">Open on public holidays? <span class="text-danger">*</span></legend><div class="d-flex gap-4"><label><input type="radio" name="publicHolidayTrading" checked="@(OpenOnPublicHolidays == true)" @onchange="() => OpenOnPublicHolidays = true" /> Yes</label><label><input type="radio" name="publicHolidayTrading" checked="@(OpenOnPublicHolidays == false)" @onchange="() => OpenOnPublicHolidays = false" /> No</label></div></fieldset></div>
            </div>
        </div></div>
        <div class="card business-info-card mb-4"><div class="card-body">
            <div class="business-info-card-heading"><span class="business-info-card-icon"><PhosphorIcon Name="map-pin" /></span><h5 class="mb-0">Place of Business / Trading Address</h5></div>
            <p class="text-muted">Enter the physical address where the business operates or trades.</p>
            <div class="row g-3">
                <div class="col-12">@FieldLabel("addressLine1", "Address Line 1")<input id="addressLine1" class="form-control" @bind="PlaceOfBusinessAddressLine1" @bind:event="oninput" /></div>
                <div class="col-12"><label class="form-label fw-semibold" for="addressLine2">Address Line 2</label><input id="addressLine2" class="form-control" @bind="PlaceOfBusinessAddressLine2" @bind:event="oninput" /></div>
                <div class="col-12 col-md-6">@FieldLabel("suburb", "Suburb")<input id="suburb" class="form-control" @bind="PlaceOfBusinessSuburb" @bind:event="oninput" /></div>
                <div class="col-12 col-md-6">@FieldLabel("city", "Town / City")<input id="city" class="form-control" @bind="PlaceOfBusinessCity" @bind:event="oninput" /></div>
                <div class="col-12 col-md-4">@FieldLabel("postalCode", "Postal Code")<input id="postalCode" class="form-control" maxlength="4" inputmode="numeric" autocomplete="postal-code" @bind="PlaceOfBusinessPostalCode" @bind:event="oninput" /></div>
                <div class="col-12 col-md-8"><p class="text-muted">We will check your trading address and determine the responsible municipality before you continue.</p></div>
                <div class="col-12"><fieldset><legend class="form-label fw-semibold fs-6">Is your postal address the same as your Place of Business / Trading Address? <span class="text-danger">*</span></legend><div id="postalSameAsBusiness" class="d-flex gap-4"><label><input type="radio" name="postalSame" checked="@(PostalSameAsBusiness == true)" @onchange="() => SetPostalSelection(true)" /> Yes</label><label><input type="radio" name="postalSame" checked="@(PostalSameAsBusiness == false)" @onchange="() => SetPostalSelection(false)" /> No</label></div></fieldset></div>
                @if (PostalSameAsBusiness == false) { <div class="col-12">@FieldLabel("postalAddressLine1", "Postal Address Line 1")<input id="postalAddressLine1" class="form-control" maxlength="150" @bind="PostalAddressLine1" @bind:event="oninput" /></div><div class="col-12"><label class="form-label fw-semibold" for="postalAddressLine2">Postal Address Line 2</label><input id="postalAddressLine2" class="form-control" maxlength="150" @bind="PostalAddressLine2" @bind:event="oninput" /></div><div class="col-12 col-md-6">@FieldLabel("postalSuburb", "Suburb")<input id="postalSuburb" class="form-control" maxlength="100" @bind="PostalSuburb" @bind:event="oninput" /></div><div class="col-12 col-md-6">@FieldLabel("postalCity", "City / Town")<input id="postalCity" class="form-control" maxlength="100" @bind="PostalCity" @bind:event="oninput" /></div><div class="col-12 col-md-4">@FieldLabel("postalPostalCode", "Postal Code")<input id="postalPostalCode" class="form-control" maxlength="4" inputmode="numeric" autocomplete="postal-code" @bind="PostalPostalCode" @bind:event="oninput" /></div> }
            </div>
        </div></div>
    </section>
}

@if (CurrentStep == 4)
{
    <section class="licence-info-step" aria-labelledby="licence-info-heading">
        <div class="licence-info-header"><h4 id="licence-info-heading" class="fw-bold mb-2">Licence-Specific Details</h4><p class="text-muted mb-0">Only questions relevant to @LicenceType are shown.</p></div>
        <div class="card licence-info-card mb-4"><div class="card-body">
            <div class="licence-info-card-heading"><span class="licence-info-card-icon"><PhosphorIcon Name="clipboard-text" /></span><h5 class="mb-0">@LicenceType</h5></div>
            <div class="row g-3">@foreach (var question in SelectedLicence?.Questions ?? []) { <div class="col-12 @(question.Type == QuestionType.Text ? "" : "col-md-6")">@FieldLabel(question.Key, question.Label) @if (question.Type == QuestionType.Text) { <textarea id="@question.Key" class="form-control" rows="2" value="@GetAnswer(question.Key)" @oninput="@(e => SetAnswer(question.Key, e.Value?.ToString()))"></textarea> } else { <select id="@question.Key" class="form-select" value="@GetAnswer(question.Key)" @onchange="@(e => SetAnswer(question.Key, e.Value?.ToString()))"><option value="">Select an option</option>@foreach (var option in question.Options) { <option value="@option">@option</option> }</select> }</div> }</div>
        </div></div>
    </section>
}

@if (CurrentStep == 5)
{
    <section class="supporting-documents-step" aria-labelledby="documents-heading">
        <div class="supporting-documents-header"><h4 id="documents-heading" class="fw-bold mb-2">Supporting Documents</h4><p class="text-muted mb-0">Upload the documents required for @LicenceType. The generated PDF is not a supporting document.</p></div>
        <div class="card supporting-documents-card mb-4"><div class="card-body"><div class="supporting-documents-card-heading"><span class="supporting-documents-card-icon"><PhosphorIcon Name="files" /></span><h5 class="mb-0">Required Documents</h5></div><div class="supporting-document-list">
            @foreach (var requirement in SelectedLicence?.Documents ?? [])
            {
                var selected = SelectedDocuments.FirstOrDefault(document => document.DocumentType == requirement.DocumentType);
                <div class="supporting-document-item"><div class="supporting-document-details"><span class="supporting-document-icon"><PhosphorIcon Name="file-text" /></span><div><h6 class="fw-bold mb-1">@requirement.DocumentType <span class="text-danger">*</span></h6><p class="text-muted mb-0">@requirement.Description</p></div></div><div class="supporting-document-upload"><label class="form-label fw-semibold">@(selected == null ? "Upload" : "Replace") @requirement.DocumentType</label><InputFile class="form-control" accept=".pdf,.png,.jpg,.jpeg" disabled="@(ReadingDocumentType == requirement.DocumentType || (requirement.DocumentType == OwnerIdDocumentType && OwnerIdValidationInProgress))" OnChange="@(e => HandleFileSelected(e, requirement.DocumentType))" />@if (ReadingDocumentType == requirement.DocumentType) { <div class="mt-2 text-muted" role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Reading document...</div> }@if (selected != null) { <div class="supporting-document-selected-file mt-3"><PhosphorIcon Name="check-circle" CssClass="me-2" /><strong>@selected.FileName</strong> — Uploaded <button type="button" class="btn btn-link btn-sm text-danger" @onclick="() => RemoveDocument(selected.DocumentType)">Remove</button></div> }@if (requirement.DocumentType == OwnerIdDocumentType && AiDocumentValidationEnabled) { @if (OwnerIdValidationInProgress) { <div class="mt-2 text-muted" role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Verifying document...</div> } else if (OwnerIdValidationStatus == AiDocumentValidationStatus.Match) { <div class="alert alert-success mt-2 mb-0" role="status"><strong>Document verified.</strong> This file appears to be an Owner ID or Passport document. This is a document-type check only, not authentication.</div> } else if (OwnerIdValidationStatus == AiDocumentValidationStatus.NoMatch) { <div class="alert alert-danger mt-2 mb-0" role="alert"><strong>Incorrect document.</strong> This file does not appear to be an Owner ID or Passport. Please upload the correct document.</div> } else if (OwnerIdValidationStatus == AiDocumentValidationStatus.Unavailable) { <div class="alert alert-warning mt-2 mb-0" role="status">Automatic document verification is currently unavailable. Your document can still be submitted for municipal review.</div> } }</div></div>
            }
        </div></div></div>
        <div class="card supporting-documents-card mb-4"><div class="card-body">
            <div class="supporting-documents-card-heading"><span class="supporting-documents-card-icon"><PhosphorIcon Name="file-plus" /></span><div><h5 class="mb-1">Additional Supporting Documents (Optional)</h5><p class="text-muted mb-0">Upload any additional documents relevant to your application or requested by your municipality.</p></div></div>
            <div class="supporting-document-upload mt-3"><label class="form-label fw-semibold">Add supporting document</label><InputFile class="form-control" accept=".pdf,.png,.jpg,.jpeg" disabled="@AddingAdditionalDocument" OnChange="HandleAdditionalFileSelected" />
                @if (AddingAdditionalDocument) { <div class="mt-2 text-muted" role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Uploading document...</div> }
            </div>
            @if (AdditionalDocuments.Count > 0)
            {
                <div class="supporting-document-list mt-3">
                    @foreach (var document in AdditionalDocuments)
                    {
                        <div class="supporting-document-item" @key="document.DocumentType"><div class="supporting-document-details"><span class="supporting-document-icon"><PhosphorIcon Name="file-text" /></span><div><strong>@document.FileName</strong><p class="text-muted mb-0">Additional supporting document</p></div></div><button type="button" class="btn btn-link btn-sm text-danger" @onclick="() => RemoveDocument(document.DocumentType)">Remove</button></div>
                    }
                </div>
            }
        </div></div>
    </section>
}

@if (CurrentStep == 6)
{
    <section class="review-submit-step" aria-labelledby="review-heading">
        <div class="review-submit-header"><h4 id="review-heading" class="fw-bold mb-2">Review & Declaration</h4><p class="text-muted mb-0">Verify all information before making the declaration.</p></div>
        <div class="row g-4">
            <div class="col-12 col-lg-6"><div class="card review-submit-card h-100"><div class="card-body"><h5 class="mb-3">Applicant</h5>@ReviewItem("Application Type", ApplicationType)@ReviewItem("Licence Type", LicenceType)@ReviewItem("Applicant Name", FullApplicantName)@ReviewItem("Address", FormattedApplicantAddress)@ReviewItem("Telephone", ApplicantTelephone)@ReviewItem("Email", ApplicantEmail)</div></div></div>
            <div class="col-12 col-lg-6"><div class="card review-submit-card h-100"><div class="card-body"><h5 class="mb-3">Business</h5>@ReviewItem("Business Name", BusinessName)@ReviewItem("Nature", BusinessCategory)@ReviewItem("Place of Business / Trading Address", FormattedPlaceOfBusinessAddress)@ReviewItem("Postal Address", FormattedPostalAddress)@ReviewItem("Responsible Municipality", RoutingState.Municipality ?? ProvisionalMunicipality)@ReviewItem("Trading Hours", ApplicationEntry.FormatTradingHours(ApplicationEntry.SerializeTradingHours(TradingDays)))@ReviewItem("Open on public holidays", ApplicationEntry.FormatPublicHolidayTrading(OpenOnPublicHolidays))</div></div></div>
            <div class="col-12"><div class="card review-submit-card"><div class="card-body"><h5 class="mb-3">@LicenceType Details</h5>@foreach (var question in SelectedLicence?.Questions ?? []) { @ReviewItem(question.Label, GetAnswer(question.Key)) }</div></div></div>
            <div class="col-12"><div class="card review-submit-card"><div class="card-body"><h5 class="mb-3">Supporting Documents</h5>@foreach (var document in SelectedDocuments) { @ReviewItem(ApplicationDocumentTypes.DisplayName(document.DocumentType), document.FileName) }</div></div></div>
        </div>
        <div class="card review-submit-card review-consent-card mt-4"><div class="card-body"><h5 class="mb-3">Consent and Declaration</h5><div class="form-check review-consent-check mb-3"><input class="form-check-input" type="checkbox" id="declaration" @bind="DeclarationAccepted" /><label class="form-check-label" for="declaration">I declare that the information supplied is true and correct and that I am authorised to submit this application.</label></div><div class="form-check review-consent-check"><input class="form-check-input" type="checkbox" id="popiaConsent" @bind="PopiaConsentAccepted" /><label class="form-check-label" for="popiaConsent">I consent to the collection and storage of my information for processing this application.</label></div></div></div>
    </section>
}

@if (CurrentStep == 7)
{
    <section class="review-submit-step" aria-labelledby="submit-heading"><div class="card review-submit-card review-submit-summary-card"><div class="card-body text-center py-5"><PhosphorIcon Name="file-pdf" CssClass="ph-icon-lg" /><h4 id="submit-heading" class="fw-bold mt-3">@(IsCorrectionMode ? "Ready to Resubmit" : "Ready to Submit")</h4><p class="text-muted mx-auto" style="max-width:680px">@(IsCorrectionMode ? "Resubmitting will update this existing application and regenerate its official PDF for municipal review." : "Submitting will save the application, generate the official completed PDF, and send it to the municipality determined from your checked trading address. Supporting documents remain separate.")</p><div class="alert alert-info text-start mt-4 mb-0">After submission, use your dashboard to track progress and download the generated application PDF.</div></div></div></section>
}

</fieldset>
<div class="mt-5 d-flex flex-wrap align-items-center gap-2">@if (CurrentStep > 1) { <button class="btn btn-outline-secondary" disabled="@IsBusy" @onclick="PreviousStep"><PhosphorIcon Name="arrow-left" /> Back</button> } @if (CurrentStep < TotalSteps) { <button class="btn btn-primary" disabled="@IsBusy" aria-busy="@RoutingState.IsRouting" @onclick="NextStep">@if (RoutingState.IsRouting) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } else { <span>Next </span><PhosphorIcon Name="arrow-right" /> } @(RoutingState.IsRouting ? "Checking address..." : "")</button> } else { <button class="btn btn-success" disabled="@IsBusy" aria-busy="@IsSubmitting" @onclick="SubmitApplication">@if (IsSubmitting) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } else { <PhosphorIcon Name="check-circle" /> } @(IsSubmitting ? (IsCorrectionMode ? "Resubmitting application..." : "Submitting application...") : (IsCorrectionMode ? "Resubmit Application" : "Submit Application"))</button> } @if (CurrentStep > 1) { <button class="btn btn-outline-primary ms-md-auto" disabled="@IsBusy" @onclick="() => SaveDraftAsync(true)"><PhosphorIcon Name="floppy-disk" /> Save draft</button>@if (!IsCorrectionMode) { <button class="btn btn-link text-danger" disabled="@IsBusy" @onclick="() => ShowDeleteConfirmation = true">Delete draft</button> }<span class="small text-muted" role="status" aria-live="polite">@SaveState</span> }</div>
}

@if (ShowDeleteConfirmation)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="delete-draft-title"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="delete-draft-title">Delete draft application?</h5><button class="btn-close" disabled="@DeletingDraft" aria-label="Close" @onclick="() => ShowDeleteConfirmation = false"></button></div><div class="modal-body"><p>This will permanently delete your saved application and any documents you have uploaded. This cannot be undone.</p></div><div class="modal-footer"><button class="btn btn-outline-secondary" disabled="@DeletingDraft" @onclick="() => ShowDeleteConfirmation = false">Cancel</button><button class="btn btn-danger" disabled="@DeletingDraft" @onclick="DeleteDraft">@(DeletingDraft ? "Deleting..." : "Delete draft")</button></div></div></div></div>
}

@code {
    [SupplyParameterFromQuery] public bool Resume { get; set; }
    [Parameter] public int? CorrectionApplicationId { get; set; }
    private const int TotalSteps = 7;
    private const long MaxFileSize = 10 * 1024 * 1024;
    private const string OwnerIdDocumentType = "Owner ID Document";
    private int CurrentStep = 1;
    private bool IsSubmitting, MessageIsError, DeclarationAccepted, PopiaConsentAccepted, ScrollToStep;
    private bool AiDocumentValidationEnabled, OwnerIdValidationInProgress, AddingAdditionalDocument;
    private bool ShowExistingDraftChoice, ShowDeleteConfirmation, DeletingDraft;
    private bool? PostalSameAsBusiness;
    private bool? OpenOnPublicHolidays;
    private string? InvalidFieldId;
    private string? ReadingDocumentType;
    private string SaveState = "";
    private string CorrectionRequest = "", CorrectionApplicationNumber = "";
    private DateTime? CorrectionRequestedAt;
    private string? ProvisionalMunicipality;
    private ApplicationDraft? ExistingDraft;
    private ApplicationDraftSummary? ExistingDraftSummary;
    private CancellationTokenSource? AutosaveDelay;
    private readonly SemaphoreSlim SaveGate = new(1, 1);
    private AiDocumentValidationStatus? OwnerIdValidationStatus;
    private string Message = "", LicenceType = "", ApplicationType = "", ApplicantFirstName = "", ApplicantLastName = "", ApplicantAddressLine1 = "", ApplicantAddressLine2 = "", ApplicantSuburb = "", ApplicantCity = "", ApplicantPostalCode = "", ApplicantTelephone = "", ApplicantEmail = "";
    private string BusinessName = "", RegistrationNumber = "", TaxNumber = "", BusinessCategory = "", ContactPerson = "", BusinessTelephone = "", BusinessEmail = "";
    private string PlaceOfBusinessAddressLine1 = "", PlaceOfBusinessAddressLine2 = "", PlaceOfBusinessSuburb = "", PlaceOfBusinessCity = "", PlaceOfBusinessPostalCode = "", PostalAddressLine1 = "", PostalAddressLine2 = "", PostalSuburb = "", PostalCity = "", PostalPostalCode = "";
    private readonly List<TradingDay> TradingDays = ApplicationEntry.Days.Select(day => new TradingDay { Day = day }).ToList();
    private readonly Dictionary<string, string> LicenceAnswers = new();
    private readonly List<SelectedDocument> SelectedDocuments = new();
    private readonly RetainedMunicipalRoutingState RoutingState = new();
    private static readonly (int Number, string Label)[] WizardSteps =
    [
        (1, "Licence Type"), (2, "Applicant Details"), (3, "Business Details"),
        (4, "Licence-Specific Details"), (5, "Supporting Documents"),
        (6, "Review & Declaration"), (7, "Submit")
    ];

    private LicenceDefinition? SelectedLicence => LicenceApplicationCatalog.Find(LicenceType);
    private List<SelectedDocument> AdditionalDocuments => SelectedDocuments.Where(document => ApplicationDocumentTypes.IsAdditional(document.DocumentType)).ToList();
    private bool IsCorrectionMode => CorrectionApplicationId.HasValue;
    private bool IsBusy => IsSubmitting || RoutingState.IsRouting;
    private string FormattedPlaceOfBusinessAddress => string.Join(", ", new[] { PlaceOfBusinessAddressLine1, PlaceOfBusinessAddressLine2, PlaceOfBusinessSuburb, PlaceOfBusinessCity, PlaceOfBusinessPostalCode }.Where(value => !string.IsNullOrWhiteSpace(value)));
    private string FullApplicantName => $"{ApplicantFirstName.Trim()} {ApplicantLastName.Trim()}".Trim();
    private string FormattedApplicantAddress => ApplicationEntry.FormatAddress(ApplicantAddressLine1, ApplicantAddressLine2, ApplicantSuburb, ApplicantCity, ApplicantPostalCode);
    private string FormattedPostalAddress => PostalSameAsBusiness == true ? FormattedPlaceOfBusinessAddress : ApplicationEntry.FormatAddress(PostalAddressLine1, PostalAddressLine2, PostalSuburb, PostalCity, PostalPostalCode);
    private string StepTitle => CurrentStep switch { 1 => "Licence Type", 2 => "Applicant Details", 3 => "Business Details", 4 => "Licence-Specific Details", 5 => "Supporting Documents", 6 => "Review & Declaration", 7 => "Submit", _ => "" };
    private static string ProgressStateLabel(string state) => state switch { "completed" => "Completed", "current" => "Current", _ => "Upcoming" };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(state.User);
        if (user != null) { var split = user.FullName.Trim().Split(' ', 2, StringSplitOptions.RemoveEmptyEntries); ApplicantFirstName = split.ElementAtOrDefault(0) ?? ""; ApplicantLastName = split.ElementAtOrDefault(1) ?? ""; ApplicantEmail = user.Email ?? ""; ApplicantTelephone = user.PhoneNumber ?? ""; }
        AiDocumentValidationEnabled = await AiSettings.IsDocumentValidationEnabledAsync();
        if (IsCorrectionMode)
        {
            try
            {
                var correction = await Corrections.LoadOrCreateDraftAsync(state.User, CorrectionApplicationId!.Value);
                ExistingDraft = correction.Draft;
                CorrectionRequest = correction.Request.Content;
                CorrectionRequestedAt = correction.Request.CreatedAtUtc;
                CorrectionApplicationNumber = await Db.Applications.Where(a => a.Id == CorrectionApplicationId.Value).Select(a => a.ApplicationNumber).SingleAsync();
                LoadDraft(ExistingDraft);
            }
            catch (UnauthorizedAccessException) { SetError("You do not have access to edit this application, or it is no longer awaiting corrections."); }
            catch (System.ComponentModel.DataAnnotations.ValidationException error) { SetError(error.Message); }
            return;
        }
        ExistingDraft = await Drafts.GetAsync(state.User);
        if (ExistingDraft != null)
        {
            ExistingDraftSummary = await Drafts.GetSummaryAsync(state.User);
            if (Resume) LoadDraft(ExistingDraft);
            else ShowExistingDraftChoice = true;
        }
    }

    private async Task SelectLicence(LicenceDefinition definition)
    {
        if (IsCorrectionMode) return;
        if (LicenceType == definition.Name) return;
        if (ExistingDraft != null)
            foreach (var document in SelectedDocuments.ToList())
                await Drafts.RemoveDocumentAsync((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User, document.DocumentType);
        LicenceType = definition.Name; LicenceAnswers.Clear(); SelectedDocuments.Clear(); OwnerIdValidationStatus = null; OwnerIdValidationInProgress = false;
        foreach (var question in definition.Questions) LicenceAnswers[question.Key] = "";
        DraftChanged(default!);
    }

    private string GetAnswer(string key) => LicenceAnswers.GetValueOrDefault(key, "");
    private void SetAnswer(string key, string? value) => LicenceAnswers[key] = value?.Trim() ?? "";
    private async Task NextStep()
    {
        if (IsBusy) return;
        Message = "";
        InvalidFieldId = null;
        if (!ValidateStep(CurrentStep)) return;
        if (CurrentStep != 3)
        {
            CurrentStep++;
            ScrollToStep = true;
            await SaveDraftAsync();
            return;
        }

        var address = CurrentTradingAddress();
        MessageIsError = false;
        Message = "Checking your trading address...";
        try
        {
            var attempt = await RoutingState.RouteAsync(address,
                item => RoutingService.ResolveAsync(item),
                async routingName => { await MunicipalityManagementService.RequireActiveRoutingAsync(Db, routingName); });
            if (!attempt.Completed) return;
            if (attempt.Result is not { Success: true })
            {
                SetError(attempt.Result?.Message ?? new MunicipalRoutingResult(null, RoutingFailure.Unavailable).Message);
                return;
            }
            CurrentStep++;
            Message = "";
            ProvisionalMunicipality = RoutingState.Municipality;
            ScrollToStep = true;
            await SaveDraftAsync();
        }
        catch (System.ComponentModel.DataAnnotations.ValidationException)
        {
            RoutingState.Clear();
            SetError(MunicipalityManagementService.UnavailableRoutingMessage);
        }
        catch (Exception)
        {
            RoutingState.Clear();
            SetError(new MunicipalRoutingResult(null, RoutingFailure.Unavailable).Message);
        }
    }

    private async Task PreviousStep() { if (IsBusy) return; Message = ""; InvalidFieldId = null; CurrentStep--; ScrollToStep = true; await SaveDraftAsync(); }
    private void SetPostalSelection(bool same) { PostalSameAsBusiness = same; if (same) { PostalAddressLine1 = PostalAddressLine2 = PostalSuburb = PostalCity = PostalPostalCode = ""; } }
    private static void SetDayStatus(TradingDay day, string? status)
    {
        day.IsOpen = status switch { "open" => true, "closed" => false, _ => null };
        if (day.IsOpen != true) day.OpeningTime = day.ClosingTime = "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ScrollToStep) { ScrollToStep = false; await JS.InvokeVoidAsync("applicationWizard.scrollToStep"); }
        else if (InvalidFieldId is { } id) { InvalidFieldId = null; await JS.InvokeVoidAsync("applicationWizard.focusInvalid", id); }
    }

    private bool ValidateStep(int step)
    {
        var error = step switch
        {
            1 when SelectedLicence == null => "Please select a licence type before continuing.",
            2 when ApplicationEntry.ValidateName(ApplicantFirstName, ApplicantLastName) is { } nameError => nameError,
            2 when !ApplicationEntry.ValidApplicationType(ApplicationType) => "Select a valid application type.",
            2 when AnyBlank(ApplicationType, ApplicantAddressLine1, ApplicantSuburb, ApplicantCity, ApplicantPostalCode, ApplicantTelephone, ApplicantEmail) => "Please complete all required applicant details.",
            2 when !ApplicationEntry.ValidPostalCode(ApplicantPostalCode) => "Postal Code must contain exactly 4 digits.",
            2 when !ApplicationEntry.ValidTelephone(ApplicantTelephone) => "Enter a valid telephone number containing 7 to 15 digits.",
            2 when !ApplicationEntry.ValidEmail(ApplicantEmail) => "Enter a valid email address, for example name@example.com.",
            2 when ApplicantFirstName.Trim().Length > 100 || ApplicantLastName.Trim().Length > 100 || ApplicantAddressLine1.Trim().Length > 150 || ApplicantAddressLine2.Trim().Length > 150 || ApplicantSuburb.Trim().Length > 100 || ApplicantCity.Trim().Length > 100 => "One or more applicant fields exceed the allowed length.",
            3 when AnyBlank(BusinessName, RegistrationNumber, TaxNumber, BusinessCategory, ContactPerson, BusinessTelephone, BusinessEmail, PlaceOfBusinessAddressLine1, PlaceOfBusinessSuburb, PlaceOfBusinessCity, PlaceOfBusinessPostalCode) => "Please complete all required business and trading address details.",
            3 when !ApplicationEntry.ValidRegistration(RegistrationNumber) => "Company Registration Number must use the format YYYY/NNNNNN/XX.",
            3 when !ApplicationEntry.ValidTaxNumber(TaxNumber) => "Tax Number must contain exactly 10 digits.",
            3 when !ApplicationEntry.ValidTelephone(BusinessTelephone) => "Enter a valid telephone number containing 7 to 15 digits.",
            3 when !ApplicationEntry.ValidEmail(BusinessEmail) => "Enter a valid email address, for example name@example.com.",
            3 when !ApplicationEntry.ValidPostalCode(PlaceOfBusinessPostalCode) => "Postal Code must contain exactly 4 digits.",
            3 when ApplicationEntry.ValidateTradingHours(TradingDays) is { } hoursError => hoursError,
            3 when ApplicationEntry.ValidatePublicHolidayTrading(OpenOnPublicHolidays) is { } publicHolidayError => publicHolidayError,
            3 when ApplicationEntry.ValidatePostalAddress(PostalSameAsBusiness, PostalAddressLine1, PostalSuburb, PostalCity, PostalPostalCode) is { } postalError => postalError,
            3 when PostalSameAsBusiness == false && !ApplicationEntry.ValidPostalCode(PostalPostalCode) => "Postal Code must contain exactly 4 digits.",
            3 when PostalSameAsBusiness == false && (PostalAddressLine1.Trim().Length > 150 || PostalAddressLine2.Trim().Length > 150 || PostalSuburb.Trim().Length > 100 || PostalCity.Trim().Length > 100 || PostalPostalCode.Trim().Length > 12) => "One or more postal address fields exceed the allowed length.",
            4 when SelectedLicence?.Questions.Any(question => question.Required && string.IsNullOrWhiteSpace(GetAnswer(question.Key))) == true => "Please answer every required licence-specific question.",
            4 when SelectedLicence?.Questions.Any(question => !ApplicationEntry.ValidLicenceAnswer(GetAnswer(question.Key), question.Required, question.Options)) == true => "Select a valid option for every required licence-specific question.",
            5 when SelectedLicence?.Documents.Any(requirement => requirement.Required && !SelectedDocuments.Any(document => document.DocumentType == requirement.DocumentType)) == true => "Please upload every required supporting document.",
            5 when AiDocumentValidationEnabled && SelectedDocuments.Any(document => document.DocumentType == OwnerIdDocumentType) && (OwnerIdValidationInProgress || OwnerIdValidationStatus == null) => "Please wait for Owner ID document verification to finish.",
            5 when AiDocumentValidationEnabled && OwnerIdValidationStatus is { } status && AiDocumentValidationPolicy.BlocksProgress(status) => "The Owner ID document is the incorrect document type. Please upload an Owner ID or Passport document.",
            6 when !DeclarationAccepted || !PopiaConsentAccepted => "Please accept both the declaration and POPIA consent before continuing.",
            _ => null
        };
        if (error == null) return true;
        SetError(error);
        InvalidFieldId = step switch
        {
            1 => "licence-type-heading",
            2 => FirstBlank(("applicantFirstName", ApplicantFirstName), ("applicantLastName", ApplicantLastName), ("applicationType", ApplicationType), ("applicantAddressLine1", ApplicantAddressLine1), ("applicantSuburb", ApplicantSuburb), ("applicantCity", ApplicantCity), ("applicantPostalCode", ApplicantPostalCode), ("applicantTelephone", ApplicantTelephone), ("applicantEmail", ApplicantEmail))
                ?? (!ApplicationEntry.ValidApplicationType(ApplicationType) ? "applicationType" : !ApplicationEntry.ValidPostalCode(ApplicantPostalCode) ? "applicantPostalCode" : !ApplicationEntry.ValidTelephone(ApplicantTelephone) ? "applicantTelephone" : !ApplicationEntry.ValidEmail(ApplicantEmail) ? "applicantEmail" : null),
            3 => FirstBlank(("businessName", BusinessName), ("registrationNumber", RegistrationNumber), ("taxNumber", TaxNumber), ("businessCategory", BusinessCategory), ("contactPerson", ContactPerson), ("businessTelephone", BusinessTelephone), ("businessEmail", BusinessEmail), ("addressLine1", PlaceOfBusinessAddressLine1), ("suburb", PlaceOfBusinessSuburb), ("city", PlaceOfBusinessCity), ("postalCode", PlaceOfBusinessPostalCode))
                ?? (!ApplicationEntry.ValidRegistration(RegistrationNumber) ? "registrationNumber" : !ApplicationEntry.ValidTaxNumber(TaxNumber) ? "taxNumber" : !ApplicationEntry.ValidTelephone(BusinessTelephone) ? "businessTelephone" : !ApplicationEntry.ValidEmail(BusinessEmail) ? "businessEmail" : !ApplicationEntry.ValidPostalCode(PlaceOfBusinessPostalCode) ? "postalCode" : error.Contains("public holidays", StringComparison.OrdinalIgnoreCase) ? "publicHolidayTrading" : error.Contains("trading", StringComparison.OrdinalIgnoreCase) || error.Contains("Closing Time") || error.Contains("opening and closing") || error.Contains("Open or Closed") || error.Contains("HH:mm") ? "tradingHours" : PostalSameAsBusiness == null ? "postalSameAsBusiness" : PostalSameAsBusiness == false ? FirstBlank(("postalAddressLine1", PostalAddressLine1), ("postalSuburb", PostalSuburb), ("postalCity", PostalCity), ("postalPostalCode", PostalPostalCode)) ?? (!ApplicationEntry.ValidPostalCode(PostalPostalCode) ? "postalPostalCode" : "postalAddressLine1") : null),
            4 => SelectedLicence?.Questions.FirstOrDefault(question => !ApplicationEntry.ValidLicenceAnswer(GetAnswer(question.Key), question.Required, question.Options))?.Key,
            6 => !DeclarationAccepted ? "declaration" : "popiaConsent",
            _ => null
        };
        return false;
    }

    private static bool AnyBlank(params string[] values) => values.Any(string.IsNullOrWhiteSpace);
    private static string? FirstBlank(params (string Id, string Value)[] fields) => fields.FirstOrDefault(field => string.IsNullOrWhiteSpace(field.Value)).Id;
    private void SetError(string message) { Message = message; MessageIsError = true; }
    private TradingAddress CurrentTradingAddress() => new(
        PlaceOfBusinessAddressLine1.Trim(), PlaceOfBusinessAddressLine2.Trim(), PlaceOfBusinessSuburb.Trim(),
        PlaceOfBusinessCity.Trim(), PlaceOfBusinessPostalCode.Trim());

    private async Task HandleFileSelected(InputFileChangeEventArgs args, string documentType)
    {
        if (ReadingDocumentType == documentType || OwnerIdValidationInProgress || IsSubmitting) return;
        Message = ""; var file = args.File; var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (extension is not (".pdf" or ".png" or ".jpg" or ".jpeg")) { SetError("Supporting documents must be PDF, PNG or JPEG files."); return; }
        ReadingDocumentType = documentType;
        SelectedDocument? selected = null;
        try { using var stream = new MemoryStream(); await file.OpenReadStream(MaxFileSize).CopyToAsync(stream); selected = new(documentType, Path.GetFileName(file.Name), null, stream.ToArray()); if (documentType == OwnerIdDocumentType) OwnerIdValidationStatus = null; }
        catch (IOException) { SetError("The selected document exceeds the 10 MB file limit."); }
        finally { ReadingDocumentType = null; }
        if (selected == null) return;
        if (documentType == OwnerIdDocumentType)
        {
            AiDocumentValidationEnabled = await AiSettings.IsDocumentValidationEnabledAsync();
            if (AiDocumentValidationEnabled)
            {
                OwnerIdValidationInProgress = true;
                StateHasChanged();
                try
                {
                    OwnerIdValidationStatus = (await AiValidation.EvaluateAsync(true, documentType, selected.FileName, selected.FileBytes!)).Status;
                }
                finally
                {
                    OwnerIdValidationInProgress = false;
                }
            }
        }
        try
        {
            await SaveDraftAsync();
            var reference = await Uploads.SaveAsync(selected.FileName, selected.FileBytes!);
            try
            {
                await Drafts.ReplaceDocumentAsync((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User,
                    documentType, selected.FileName, reference, documentType == OwnerIdDocumentType ? OwnerIdValidationStatus : null,
                    CorrectionApplicationId);
            }
            catch
            {
                await Uploads.DeleteIfUnreferencedAsync(Db, reference);
                throw;
            }
            selected = selected with { FilePath = reference, FileBytes = null };
            SelectedDocuments.RemoveAll(item => item.DocumentType == documentType);
            SelectedDocuments.Add(selected);
            SaveState = "Saved";
        }
        catch
        {
            SetError("The document could not be saved. Please try again.");
            SaveState = "Unable to save";
        }
    }

    private async Task SubmitApplication()
    {
        if (IsBusy) return;
        Message = ""; for (var step = 1; step <= 6; step++) if (!ValidateStep(step)) { CurrentStep = step; StateHasChanged(); return; }
        if (IsCorrectionMode)
        {
            await SaveDraftAsync();
            IsSubmitting = true;
            try
            {
                await Corrections.ResubmitAsync((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User, CorrectionApplicationId!.Value);
                Nav.NavigateTo($"/tracking/{CorrectionApplicationId.Value}");
            }
            catch (UnauthorizedAccessException) { SetError("You no longer have access to resubmit this application."); }
            catch (System.ComponentModel.DataAnnotations.ValidationException error) { SetError(error.Message); }
            catch (Exception error) { Logger.LogError(error, "Correction resubmission failed. ApplicationId={ApplicationId}", CorrectionApplicationId); SetError("The corrected application could not be resubmitted. Please try again."); }
            finally { IsSubmitting = false; }
            return;
        }
        IsSubmitting = true;
        AutosaveDelay?.Cancel();

        try
        {
            await SaveGate.WaitAsync();
            SaveGate.Release();
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync(); var user = await UserManager.GetUserAsync(state.User);
            if (user == null) { SetError("You must be logged in to submit an application."); return; }
            var address = CurrentTradingAddress();
            if (!RoutingState.IsValidFor(address))
            {
                CurrentStep = 3;
                SetError("Your trading address needs to be checked again before you can submit. Please review it and click Next.");
                return;
            }
            MessageIsError = false;
            Message = "Saving application and generating PDF...";
            StateHasChanged();
            await using var transaction = await Db.Database.BeginTransactionAsync();
            BusinessLicensing_Practice.Models.Municipality participatingMunicipality;
            try
            {
                participatingMunicipality = await MunicipalityManagementService.RequireActiveRoutingAsync(Db, RoutingState.Municipality!);
            }
            catch (System.ComponentModel.DataAnnotations.ValidationException error)
            {
                RoutingState.Clear();
                CurrentStep = 3;
                SetError(error.Message);
                return;
            }
            var now = DateTime.UtcNow; var count = await Db.Applications.CountAsync(item => item.DateSubmitted.Year == now.Year);
            var application = new Application
            {
                ApplicationNumber = $"APP-{now.Year}-{count + 1:D3}", BusinessName = BusinessName.Trim(), RegistrationNumber = RegistrationNumber.Trim(), TaxNumber = TaxNumber.Trim(), BusinessCategory = BusinessCategory.Trim(),
                PlaceOfBusinessAddress = address.Formatted, PlaceOfBusinessAddressLine1 = address.Line1, PlaceOfBusinessAddressLine2 = address.Line2, PlaceOfBusinessSuburb = address.Suburb, PlaceOfBusinessCity = address.City, PlaceOfBusinessPostalCode = address.PostalCode, LicenceType = LicenceType, Municipality = participatingMunicipality.Name,
                PopiaConsentAccepted = true, Status = "Submitted", DateSubmitted = now, UserId = user.Id,
                Details = new ApplicationDetails { ApplicationType = ApplicationType, ApplicantFirstName = ApplicantFirstName.Trim(), ApplicantLastName = ApplicantLastName.Trim(), ApplicantAddressLine1 = ApplicantAddressLine1.Trim(), ApplicantAddressLine2 = ApplicantAddressLine2.Trim(), ApplicantSuburb = ApplicantSuburb.Trim(), ApplicantCity = ApplicantCity.Trim(), ApplicantPostalCode = ApplicantPostalCode.Trim(), ApplicantTelephone = ApplicantTelephone.Trim(), ApplicantEmail = ApplicantEmail.Trim(), PostalAddressSameAsBusiness = PostalSameAsBusiness, PostalAddressLine1 = PostalSameAsBusiness == false ? PostalAddressLine1.Trim() : null, PostalAddressLine2 = PostalSameAsBusiness == false ? PostalAddressLine2.Trim() : null, PostalSuburb = PostalSameAsBusiness == false ? PostalSuburb.Trim() : null, PostalCity = PostalSameAsBusiness == false ? PostalCity.Trim() : null, PostalPostalCode = PostalSameAsBusiness == false ? PostalPostalCode.Trim() : null, ContactPerson = ContactPerson.Trim(), BusinessTelephone = BusinessTelephone.Trim(), BusinessEmail = BusinessEmail.Trim(), TradingHours = ApplicationEntry.SerializeTradingHours(TradingDays), OpenOnPublicHolidays = OpenOnPublicHolidays, LicenceSpecificDetailsJson = JsonSerializer.Serialize(LicenceAnswers), DeclarationAccepted = true, DeclarationAcceptedAt = now }
            };
            var draft = await Db.ApplicationDrafts.Include(item => item.Documents)
                .SingleOrDefaultAsync(item => item.UserId == user.Id && item.SourceApplicationId == null);
            if (draft == null) throw new InvalidOperationException("The saved draft is unavailable.");
            foreach (var selected in draft.Documents) application.Documents.Add(new ApplicationDocument { DocumentType = selected.DocumentType, FileName = selected.FileName, FilePath = selected.FilePath });
            Db.Applications.Add(application); await Db.SaveChangesAsync();
            application.ApplicationFormFileName = $"{application.ApplicationNumber}-Official-Application-r1.pdf";
            application.ApplicationFormFilePath = await FileService.SaveGeneratedPdfAsync(application.Id, application.ApplicationFormFileName, PdfService.Generate(application));
            Db.ApplicationDrafts.Remove(draft);
            await Db.SaveChangesAsync(); await transaction.CommitAsync();
            try { await Notifications.NotifySubmissionAsync(application.Id); }
            catch (Exception error)
            {
                Logger.LogError(error,
                    "Post-commit submission notification failed. ApplicationId={ApplicationId} ApplicationNumber={ApplicationNumber} Municipality={Municipality} Outcome=Failed ExceptionType={ExceptionType}",
                    application.Id, application.ApplicationNumber, application.Municipality, error.GetType().Name);
            }
            MessageIsError = false; Message = "Application submitted successfully. Your official PDF has been generated."; Nav.NavigateTo($"/tracking/{application.Id}");
        }
        catch (Exception) { SetError("The application could not be submitted. No database changes were saved. Please try again."); }
        finally { IsSubmitting = false; }
    }

    private RenderFragment FieldLabel(string id, string label) => builder =>
    {
        builder.OpenElement(0, "label"); builder.AddAttribute(1, "class", "form-label fw-semibold"); builder.AddAttribute(2, "for", id);
        builder.AddContent(3, label + " "); builder.OpenElement(4, "span"); builder.AddAttribute(5, "class", "text-danger"); builder.AddContent(6, "*"); builder.CloseElement(); builder.CloseElement();
    };
    private RenderFragment ReviewItem(string label, string? value) => @<div class="review-item">
        <span class="review-label">@label:</span>
        <span class="review-value">@(string.IsNullOrWhiteSpace(value) ? "Not provided" : value)</span>
    </div>;

    private void DraftChanged(ChangeEventArgs args)
    {
        if (CurrentStep <= 1 || ShowExistingDraftChoice) return;
        AutosaveDelay?.Cancel();
        AutosaveDelay?.Dispose();
        AutosaveDelay = new CancellationTokenSource();
        var token = AutosaveDelay.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(1000, token);
                await InvokeAsync(() => PersistDraftAsync(false));
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task HandleAdditionalFileSelected(InputFileChangeEventArgs args)
    {
        if (AddingAdditionalDocument || IsSubmitting) return;
        AddingAdditionalDocument = true;
        try { await HandleFileSelected(args, ApplicationDocumentTypes.CreateAdditional()); }
        finally { AddingAdditionalDocument = false; }
    }

    private async Task SaveDraftAsync(bool announce = false)
    {
        AutosaveDelay?.Cancel();
        await PersistDraftAsync(announce);
    }

    private async Task PersistDraftAsync(bool announce)
    {
        if (CurrentStep <= 1 || IsSubmitting) return;
        await SaveGate.WaitAsync();
        try
        {
            SaveState = "Saving...";
            StateHasChanged();
            var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            ExistingDraft = IsCorrectionMode
                ? await Corrections.SaveDraftAsync(principal, CorrectionApplicationId!.Value, CreatePayload(), CurrentStep)
                : await Drafts.SaveAsync(principal, CreatePayload(), CurrentStep);
            if (!IsCorrectionMode) ExistingDraftSummary = await Drafts.GetSummaryAsync(principal);
            SaveState = "Saved";
            if (announce) Message = "Your draft has been saved.";
        }
        catch
        {
            SaveState = "Unable to save";
            if (announce) SetError("Your draft could not be saved. Please try again.");
        }
        finally
        {
            SaveGate.Release();
            StateHasChanged();
        }
    }

    private ApplicationDraftPayload CreatePayload() => new()
    {
        LicenceType = LicenceType, ApplicationType = ApplicationType,
        ApplicantFirstName = ApplicantFirstName, ApplicantLastName = ApplicantLastName,
        ApplicantAddressLine1 = ApplicantAddressLine1, ApplicantAddressLine2 = ApplicantAddressLine2,
        ApplicantSuburb = ApplicantSuburb, ApplicantCity = ApplicantCity, ApplicantPostalCode = ApplicantPostalCode,
        ApplicantTelephone = ApplicantTelephone, ApplicantEmail = ApplicantEmail,
        BusinessName = BusinessName, RegistrationNumber = RegistrationNumber, TaxNumber = TaxNumber,
        BusinessCategory = BusinessCategory, ContactPerson = ContactPerson,
        BusinessTelephone = BusinessTelephone, BusinessEmail = BusinessEmail,
        PlaceOfBusinessAddressLine1 = PlaceOfBusinessAddressLine1, PlaceOfBusinessAddressLine2 = PlaceOfBusinessAddressLine2,
        PlaceOfBusinessSuburb = PlaceOfBusinessSuburb, PlaceOfBusinessCity = PlaceOfBusinessCity,
        PlaceOfBusinessPostalCode = PlaceOfBusinessPostalCode, PostalSameAsBusiness = PostalSameAsBusiness,
        PostalAddressLine1 = PostalAddressLine1, PostalAddressLine2 = PostalAddressLine2,
        PostalSuburb = PostalSuburb, PostalCity = PostalCity, PostalPostalCode = PostalPostalCode,
        TradingDays = TradingDays.Select(day => new TradingDay { Day = day.Day, IsOpen = day.IsOpen, OpeningTime = day.OpeningTime, ClosingTime = day.ClosingTime }).ToList(),
        OpenOnPublicHolidays = OpenOnPublicHolidays, LicenceAnswers = new(LicenceAnswers),
        DeclarationAccepted = DeclarationAccepted, PopiaConsentAccepted = PopiaConsentAccepted,
        ProvisionalMunicipality = RoutingState.Municipality ?? ProvisionalMunicipality
    };

    private void LoadDraft(ApplicationDraft draft)
    {
        var payload = ApplicationDraftService.Deserialize(draft.PayloadJson);
        LicenceType = payload.LicenceType; ApplicationType = payload.ApplicationType;
        ApplicantFirstName = payload.ApplicantFirstName; ApplicantLastName = payload.ApplicantLastName;
        ApplicantAddressLine1 = payload.ApplicantAddressLine1; ApplicantAddressLine2 = payload.ApplicantAddressLine2;
        ApplicantSuburb = payload.ApplicantSuburb; ApplicantCity = payload.ApplicantCity;
        ApplicantPostalCode = payload.ApplicantPostalCode; ApplicantTelephone = payload.ApplicantTelephone; ApplicantEmail = payload.ApplicantEmail;
        BusinessName = payload.BusinessName; RegistrationNumber = payload.RegistrationNumber; TaxNumber = payload.TaxNumber;
        BusinessCategory = payload.BusinessCategory; ContactPerson = payload.ContactPerson;
        BusinessTelephone = payload.BusinessTelephone; BusinessEmail = payload.BusinessEmail;
        PlaceOfBusinessAddressLine1 = payload.PlaceOfBusinessAddressLine1; PlaceOfBusinessAddressLine2 = payload.PlaceOfBusinessAddressLine2;
        PlaceOfBusinessSuburb = payload.PlaceOfBusinessSuburb; PlaceOfBusinessCity = payload.PlaceOfBusinessCity;
        PlaceOfBusinessPostalCode = payload.PlaceOfBusinessPostalCode; PostalSameAsBusiness = payload.PostalSameAsBusiness;
        PostalAddressLine1 = payload.PostalAddressLine1; PostalAddressLine2 = payload.PostalAddressLine2;
        PostalSuburb = payload.PostalSuburb; PostalCity = payload.PostalCity; PostalPostalCode = payload.PostalPostalCode;
        TradingDays.Clear();
        var restoredDays = payload.TradingDays.Count == ApplicationEntry.Days.Length &&
            payload.TradingDays.Select(day => day.Day).SequenceEqual(ApplicationEntry.Days) ? payload.TradingDays :
            ApplicationEntry.Days.Select(day => new TradingDay { Day = day });
        TradingDays.AddRange(restoredDays);
        OpenOnPublicHolidays = payload.OpenOnPublicHolidays;
        LicenceAnswers.Clear();
        foreach (var question in SelectedLicence?.Questions ?? []) LicenceAnswers[question.Key] = "";
        foreach (var answer in payload.LicenceAnswers) LicenceAnswers[answer.Key] = answer.Value;
        DeclarationAccepted = payload.DeclarationAccepted; PopiaConsentAccepted = payload.PopiaConsentAccepted;
        ProvisionalMunicipality = payload.ProvisionalMunicipality;
        SelectedDocuments.Clear();
        foreach (var document in draft.Documents)
            SelectedDocuments.Add(new(document.DocumentType, document.FileName, document.FilePath, null));
        var ownerDocument = draft.Documents.SingleOrDefault(item => item.DocumentType == OwnerIdDocumentType);
        OwnerIdValidationStatus = Enum.TryParse<AiDocumentValidationStatus>(ownerDocument?.AiValidationStatus, out var status) ? status : null;
        CurrentStep = Math.Clamp(draft.CurrentStep, 1, TotalSteps);
        ShowExistingDraftChoice = false;
        SaveState = $"Saved {draft.LastSavedAtUtc.ToLocalTime():g}";
    }

    private void ContinueExistingDraft()
    {
        if (ExistingDraft != null) LoadDraft(ExistingDraft);
    }

    private async Task RemoveDocument(string documentType)
    {
        await Drafts.RemoveDocumentAsync((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User, documentType, CorrectionApplicationId);
        SelectedDocuments.RemoveAll(item => item.DocumentType == documentType);
        if (documentType == OwnerIdDocumentType) OwnerIdValidationStatus = null;
        SaveState = "Saved";
    }

    private async Task DeleteDraft()
    {
        if (DeletingDraft) return;
        DeletingDraft = true;
        try
        {
            await Drafts.DeleteAsync((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);
            Nav.NavigateTo("/new-application", forceLoad: true);
        }
        finally { DeletingDraft = false; }
    }

    private static string DisplayDraftValue(string? value) => string.IsNullOrWhiteSpace(value) ? "Not yet provided" : value;
    private sealed record SelectedDocument(string DocumentType, string FileName, string? FilePath, byte[]? FileBytes);
}
