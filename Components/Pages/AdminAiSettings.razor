@page "/admin/ai-settings"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "DEDATAdmin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using BusinessLicensing_Practice.Services
@inject AiSettingsService Settings
@inject AuthenticationStateProvider Authentication

<PageTitle>AI Settings</PageTitle>
<h1 class="fw-bold">AI Settings</h1>
<p class="text-muted">Manage optional AI-assisted features. API credentials are configured securely outside this page.</p>

@if (message != null)
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")" role="alert">@message</div>
}

<div class="card shadow-sm mb-4"><div class="card-body">
    <h2 class="h5">AI Document Validation</h2>
    <p>Automatically checks whether uploaded documents appear to match the required document type.</p>
    <p>Configure each supported document check independently.</p>
    <div class="form-check form-switch mb-3">
        <input id="ai-document-validation" class="form-check-input" type="checkbox" role="switch"
               checked="@enabled" disabled="@busy" @onchange="Toggle" />
        <label class="form-check-label" for="ai-document-validation">Enable AI Document Validation: @(enabled ? "ON" : "OFF")</label>
    </div>
    <p class="text-muted mb-0">Checks whether the upload appears to be a supported Owner ID or Passport document. It does not authenticate documents or verify a person's identity.</p>
    <hr />
    <div class="form-check form-switch mb-3"><input id="ai-certificate-validation" class="form-check-input" type="checkbox" role="switch" checked="@certificateEnabled" disabled="@certificateBusy" @onchange="ToggleCertificate" /><label class="form-check-label" for="ai-certificate-validation">Certificate of Incorporation Validation: @(certificateEnabled ? "ON" : "OFF")</label></div>
    <p class="text-muted">Compares the registered business name and company registration number. This does not authenticate the certificate.</p>
    <div class="form-check form-switch mb-3"><input id="ai-address-validation" class="form-check-input" type="checkbox" role="switch" checked="@addressEnabled" disabled="@addressBusy" @onchange="ToggleAddress" /><label class="form-check-label" for="ai-address-validation">Proof of Address Validation: @(addressEnabled ? "ON" : "OFF")</label></div>
    <p class="text-muted mb-0">Compares the document's relevant physical address with the Place of Business / Trading Address. This does not authenticate the document.</p>
</div></div>

<div class="card shadow-sm"><div class="card-body">
    <h2 class="h5">AI Application Summaries</h2>
    <p>Allows Municipal Officials to generate AI-assisted summaries of applications during review.</p>
    <div class="form-check form-switch mb-3">
        <input id="ai-application-summaries" class="form-check-input" type="checkbox" role="switch"
               checked="@summariesEnabled" disabled="@summariesBusy" @onchange="ToggleSummaries" />
        <label class="form-check-label" for="ai-application-summaries">Enable AI Application Summaries: @(summariesEnabled ? "ON" : "OFF")</label>
    </div>
    <p class="text-muted mb-0">Summaries assist review only. Municipal Officials remain responsible for verifying the full application and making decisions.</p>
</div></div>

@code {
    private bool enabled;
    private bool busy;
    private bool summariesEnabled;
    private bool summariesBusy;
    private bool certificateEnabled, certificateBusy, addressEnabled, addressBusy;
    private bool isError;
    private string? message;

    protected override async Task OnInitializedAsync() => await Load();

    // Load administrator-controlled AI feature flags from their singleton row.
    private async Task Load()
    {
        try
        {
            var principal = (await Authentication.GetAuthenticationStateAsync()).User;
            enabled = await Settings.GetDocumentValidationEnabledAsync(principal);
            var documentSettings = await Settings.GetDocumentValidationSettingsAsync();
            certificateEnabled = documentSettings.CertificateOfIncorporation;
            addressEnabled = documentSettings.ProofOfAddress;
            summariesEnabled = await Settings.GetApplicationSummariesEnabledAsync(principal);
        }
        catch (UnauthorizedAccessException)
        {
            isError = true; message = "You do not have permission to manage AI settings.";
        }
    }

    private async Task ToggleCertificate(ChangeEventArgs args)
    {
        if (certificateBusy) return; certificateBusy = true; message = null; isError = false;
        var requested = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        try { await Settings.SetCertificateValidationEnabledAsync((await Authentication.GetAuthenticationStateAsync()).User, requested); certificateEnabled = requested; message = $"Certificate of Incorporation Validation is now {(requested ? "enabled" : "disabled")}."; }
        catch (UnauthorizedAccessException) { isError = true; message = "You do not have permission to manage AI settings."; }
        catch { isError = true; message = "The setting could not be updated. Refresh the page and try again."; }
        finally { certificateBusy = false; }
    }

    private async Task ToggleAddress(ChangeEventArgs args)
    {
        if (addressBusy) return; addressBusy = true; message = null; isError = false;
        var requested = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        try { await Settings.SetProofOfAddressValidationEnabledAsync((await Authentication.GetAuthenticationStateAsync()).User, requested); addressEnabled = requested; message = $"Proof of Address Validation is now {(requested ? "enabled" : "disabled")}."; }
        catch (UnauthorizedAccessException) { isError = true; message = "You do not have permission to manage AI settings."; }
        catch { isError = true; message = "The setting could not be updated. Refresh the page and try again."; }
        finally { addressBusy = false; }
    }

    private async Task ToggleSummaries(ChangeEventArgs args)
    {
        if (summariesBusy) return;
        summariesBusy = true; message = null; isError = false;
        var requested = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        try
        {
            await Settings.SetApplicationSummariesEnabledAsync((await Authentication.GetAuthenticationStateAsync()).User, requested);
            summariesEnabled = requested;
            message = $"AI Application Summaries are now {(summariesEnabled ? "enabled" : "disabled")}.";
        }
        catch (UnauthorizedAccessException) { isError = true; message = "You do not have permission to manage AI settings."; }
        catch { isError = true; message = "The setting could not be updated. Refresh the page and try again."; }
        finally { summariesBusy = false; }
    }

    private async Task Toggle(ChangeEventArgs args)
    {
        if (busy) return;
        busy = true; message = null; isError = false;
        var requested = args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        try
        {
            var principal = (await Authentication.GetAuthenticationStateAsync()).User;
            await Settings.SetDocumentValidationEnabledAsync(principal, requested);
            enabled = requested;
            message = $"AI Document Validation is now {(enabled ? "enabled" : "disabled")}.";
        }
        catch (UnauthorizedAccessException)
        {
            isError = true; message = "You do not have permission to manage AI settings.";
        }
        catch
        {
            isError = true; message = "The setting could not be updated. Refresh the page and try again.";
        }
        finally { busy = false; }
    }
}
