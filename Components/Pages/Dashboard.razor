@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@using BusinessLicensing_Practice.Data
@attribute [Authorize(Roles = "BusinessOwner")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using BusinessLicensing_Practice.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using BusinessLicensing_Practice.Services
@inject MunicipalMessageService Messages
@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ApplicationDraftService Drafts


@page "/dashboard"

@code {


    
    private List<BusinessLicensing_Practice.Models.Application> applications = new();

    private ApplicationUser? currentUser;
    private Dictionary<int, int> unreadCounts = [];
    private bool refreshingNotifications;
    private ApplicationDraftSummary? draft;
    private bool showDeleteDraft;

    private async Task RefreshNotifications()
    {
        if (refreshingNotifications) return;
        refreshingNotifications = true;
        try { await OnParametersSetAsync(); }
        finally { refreshingNotifications = false; }
    }

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        currentUser = await UserManager.GetUserAsync(authState.User);
        unreadCounts = await Messages.GetUnreadCountsAsync(authState.User);
        draft = await Drafts.GetSummaryAsync(authState.User);

        if (currentUser != null)
        {
            applications = await Db.Applications
                .Where(a => a.UserId == currentUser.Id)
                .ToListAsync();
        }
    }

    private async Task LoadApplications()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            applications = await Db.Applications
                .Where(a => a.UserId == user.Id)
                .ToListAsync();
        }
    }
    private string GetStatusBadge(string status)
    {
        return status switch
        {
            "Submitted" => "bg-secondary",
            "Under Review" => "bg-primary",
            "Additional Information Required" => "bg-warning text-dark",
            "Department Assessment" => "bg-warning text-dark",
            "Final Decision" => "bg-info text-dark",
            "Licence Issued" => "bg-success",
            "Rejected" => "bg-danger",
            "Withdrawn" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }

    private async Task DeleteDraft()
    {
        await Drafts.DeleteAsync((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);
        draft = null;
        showDeleteDraft = false;
    }
}
<AuthorizeView>
    <Authorized>
        <h1 class="fw-bold">Business Owner Dashboard</h1>
        <p class="text-muted">
            Welcome back @currentUser?.FullName, Track your license applications and view recent updates.
        </p>
    </Authorized>
</AuthorizeView>
<div class="alert alert-info" role="status">
    Municipal Messages: <span class="badge bg-primary">@unreadCounts.Values.Sum() unread</span>
    <button class="btn btn-sm btn-outline-primary ms-2" disabled="@refreshingNotifications" aria-busy="@refreshingNotifications" @onclick="RefreshNotifications">@if (refreshingNotifications) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }@(refreshingNotifications ? "Refreshing notifications..." : "Refresh notifications")</button>
    @if (refreshingNotifications) { <span class="visually-hidden" role="status">Refreshing notifications...</span> }
</div>
@if (draft != null)
{
    <section class="card border-primary mb-4" aria-labelledby="dashboard-draft-heading"><div class="card-body">
        <h2 class="h5" id="dashboard-draft-heading">Draft Application</h2>
        <p class="mb-2"><strong>@(string.IsNullOrWhiteSpace(draft.BusinessName) ? "Application in progress" : draft.BusinessName)</strong><br />@(string.IsNullOrWhiteSpace(draft.LicenceType) ? "License type not yet selected" : ApplicationTerminology.ForDisplay(draft.LicenceType))<br />Step @draft.CurrentStep of 7 · Last saved @draft.LastSavedAtUtc.ToLocalTime().ToString("g")</p>
        <div class="d-flex flex-wrap gap-2"><a class="btn btn-primary" href="/new-application?resume=true">Continue application</a><button class="btn btn-outline-danger" @onclick="() => showDeleteDraft = true">Delete draft</button></div>
    </div></section>
}
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h6>Total Applications</h6>
            <h2 style="color: blue;">@applications.Count</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h6>In Progress</h6>
            <h2 style="color: blue;">@applications.Count(a => a.Status != "Licence Issued" && a.Status != "Rejected" &&
                                                                a.Status != "Withdrawn")</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <h6>Approved</h6>
                <h2 style="color: green;">@applications.Count(a => a.Status == "Licence Issued")</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <h6>Rejected</h6>
                <h2 style="color: red;">@applications.Count(a => a.Status == "Rejected" || a.Status == "Withdrawn")</h2>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <strong>Recent Applications</strong>
        </div>

        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Application ID</th>
                        <th>Business Name</th>
                        <th>License Type</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var application in applications)
                    {
                        <tr>
                            <td>
                                @application.ApplicationNumber
                                @if (unreadCounts.GetValueOrDefault(application.Id) > 0)
                                {
                                    <a href="/tracking/@application.Id" class="badge bg-primary ms-2">@unreadCounts[application.Id] unread municipal message(s)</a>
                                }
                            </td>
                            <td>@application.BusinessName</td>
                            <td>@ApplicationTerminology.ForDisplay(application.LicenceType)</td>
                            <td>
                                <span class="badge @GetStatusBadge(application.Status)">
                                    @ApplicationTerminology.ForDisplay(application.Status)
                                </span>
                                @if (application.Status == ApplicationWorkflow.AdditionalInformationRequired)
                                {
                                    <div class="small text-warning-emphasis mt-1">Your action is required.</div>
                                }
                            </td>
                            <td>@application.DateSubmitted.ToString("yyyy/MM/dd")</td>
                            <td>
                                <a class="btn btn-primary btn-sm" href="/tracking/@application.Id"><PhosphorIcon Name="clock-clockwise" />Track</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <a class="btn btn-primary btn-lg" href="/new-application">
            <PhosphorIcon Name="file-plus" /> New Application
        </a>
    </div>

@if (showDeleteDraft)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="dashboard-delete-draft-title"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="dashboard-delete-draft-title">Delete draft application?</h5><button class="btn-close" aria-label="Close" @onclick="() => showDeleteDraft = false"></button></div><div class="modal-body">This will permanently delete your saved application and any documents you have uploaded. This cannot be undone.</div><div class="modal-footer"><button class="btn btn-outline-secondary" @onclick="() => showDeleteDraft = false">Cancel</button><button class="btn btn-danger" @onclick="DeleteDraft">Delete draft</button></div></div></div></div>
}
