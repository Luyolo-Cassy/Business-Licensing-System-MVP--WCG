@page "/official-Dashboard"
@rendermode InteractiveServer

@attribute [Authorize(Roles = "MunicipalOfficial")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using BusinessLicensing_Practice.Data
@using BusinessLicensing_Practice.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<div class="mb-4">

    <h1 class="fw-bold">
        Municipal Official Dashboard
    </h1>

    <p class="text-muted">
        Review and process business licence applications submitted by applicants.
    </p>

</div>

<div class="row mb-4">

    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6>Total Applications</h6>
            <h2 class="text-primary fw-bold">@applications.Count</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6>In Progress</h6>
            <h2 class="text-info fw-bold">
                @applications.Count(a =>
                    a.Status != "Licence Issued" &&
                    a.Status != "Rejected" &&
                    a.Status != "Withdrawn")
            </h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6>Approved</h6>
            <h2 class="text-success fw-bold">
                @applications.Count(a => a.Status == "Licence Issued")
            </h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6>Rejected</h6>
            <h2 class="text-danger fw-bold">
                @applications.Count(a =>
                    a.Status == "Rejected" ||
                    a.Status == "Withdrawn")
            </h2>
        </div>
    </div>

</div>

<div class="alert alert-warning d-flex justify-content-between align-items-center mb-4">

    <div>
        <i class="bi bi-bell-fill me-2"></i>

        <strong>
            @applications.Count(a => a.Status == "Submitted")
        </strong>

        applications are awaiting review.
    </div>

</div>

<div class="row mb-4">

    <div class="col-md-6">

        <input class="form-control"
               placeholder="Search by Business Name or Application Number..."
               @bind="SearchText"
               @bind:event="oninput" />

    </div>

    <div class="col-md-3">

        <select class="form-select" @bind="SelectedStatus">

            <option value="All">All Statuses</option>
            <option value="Submitted">Submitted</option>
            <option value="Under Review">Under Review</option>
            <option value="Department Assessment">Department Assessment</option>
            <option value="Final Decision">Final Decision</option>
            <option value="Licence Issued">Licence Issued</option>
            <option value="Rejected">Rejected</option>
            <option value="Withdrawn">Withdrawn</option>

        </select>

    </div>

</div>

<div class="card shadow-sm">

    <div class="card-header">

        <strong>
            Applications Awaiting Processing
        </strong>

    </div>

    <div class="card-body">

        <table class="table table-hover align-middle">

            <thead>

                <tr>

                    <th>Application No.</th>
                    <th>Business</th>
                    <th>Licence</th>
                    <th>Status</th>
                    <th>Date Submitted</th>
                    <th>Time Submitted</th>
                    <th>Action</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var app in FilteredApplications)
                {
                    <tr>

                        <td>@app.ApplicationNumber</td>

                        <td>@app.BusinessName</td>

                        <td>@app.LicenceType</td>

                        <td>
                            <span class="badge @GetBadge(app.Status)">
                                @app.Status
                            </span>
                        </td>

                        <td>
                            @app.DateSubmitted.ToString("yyyy/MM/dd")
                        </td>

                        <td>
                            @app.DateSubmitted.ToString("HH:mm")
                        </td>

                        <td>

                            <a class="btn btn-primary btn-sm"
                               href="/review-application/@app.Id">

                                <i class="bi bi-eye-fill me-1"></i>

                                Review

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>



@code {

    private List<Application> applications = new();

    private string SearchText = "";

    private string SelectedStatus = "All";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var official = await UserManager.GetUserAsync(authState.User);

        if (official == null || string.IsNullOrWhiteSpace(official.Municipality))
        {
            applications = new();
            return;
        }

        applications = await Db.Applications
            .Where(application => application.Municipality == official.Municipality || application.Municipality == null)
            .OrderByDescending(a => a.DateSubmitted)
            .ToListAsync();
    }

    private IEnumerable<Application> FilteredApplications =>
        applications.Where(a =>
            (string.IsNullOrWhiteSpace(SearchText)
            || a.BusinessName.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
            || a.ApplicationNumber.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
            &&
            (SelectedStatus == "All"
            || a.Status == SelectedStatus));

    private string GetBadge(string status)
    {
        return status switch
        {
            "Submitted" => "bg-secondary",
            "Under Review" => "bg-primary",
            "Department Assessment" => "bg-warning text-dark",
            "Final Decision" => "bg-info text-dark",
            "Licence Issued" => "bg-success",
            "Rejected" => "bg-danger",
            "Withdrawn" => "bg-dark",
            _ => "bg-secondary"
        };
    }

}
