@page "/official-Dashboard"
@rendermode InteractiveServer

@attribute [Authorize(Roles = "MunicipalOfficial")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using BusinessLicensing_Practice.Data
@using BusinessLicensing_Practice.Models
@using BusinessLicensing_Practice.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<div class="mb-4">

    <h1 class="fw-bold">
        Municipal Official Dashboard
    </h1>

    <p class="text-muted">
        Review and process business license applications submitted by applicants.
    </p>

</div>

<div class="row mb-4">

    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6>Total Applications</h6>
            <h2 class="text-primary fw-bold">@totalApplications</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6>In Progress</h6>
            <h2 class="text-info fw-bold">
                @inProgressCount
            </h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6>Approved</h6>
            <h2 class="text-success fw-bold">
                @approvedCount
            </h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3">
            <h6>Rejected</h6>
            <h2 class="text-danger fw-bold">
                @rejectedCount
            </h2>
        </div>
    </div>

</div>

<div class="alert alert-warning d-flex justify-content-between align-items-center mb-4">

    <div>
        <PhosphorIcon Name="bell" CssClass="me-2" />

        <strong>
            @awaitingReviewCount
        </strong>

        applications are awaiting review.
    </div>

</div>

<div class="row mb-4">

    <div class="col-md-6">

        <div class="input-group">
            <span class="input-group-text" aria-hidden="true"><PhosphorIcon Name="magnifying-glass" /></span>
            <input class="form-control"
                   placeholder="Search by Business Name or Application Number..."
                   aria-label="Search applications"
                   @bind="SearchText"
                   @bind:event="oninput"
                   @bind:after="FiltersChanged" />
        </div>

    </div>

    <div class="col-md-3">

        <select class="form-select" @bind="SelectedStatus" @bind:after="FiltersChanged">

            <option value="All">All Statuses</option>
            <option value="Submitted">Submitted</option>
            <option value="Under Review">Under Review</option>
            <option value="Additional Information Required">Additional Information Required</option>
            <option value="Department Assessment">Department Assessment</option>
            <option value="Final Decision">Final Decision</option>
            <option value="Licence Issued">License Issued</option>
            <option value="Rejected">Rejected</option>
            <option value="Withdrawn">Withdrawn</option>

        </select>

    </div>

</div>

<div class="card shadow-sm">

    <div class="card-header">

        <strong>
            Applications Awaiting Processing
        </strong>

    </div>

    <div class="card-body">

        <table class="table table-hover align-middle">

            <thead>

                <tr>

                    <th>Application No.</th>
                    <th>Business</th>
                    <th>License</th>
                    <th>Status</th>
                    <th>Date Submitted</th>
                    <th>Time Submitted</th>
                    <th>Action</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var app in applications.Items)
                {
                    <tr>

                        <td>@app.ApplicationNumber</td>

                        <td>@app.BusinessName</td>

                        <td>@ApplicationTerminology.ForDisplay(app.LicenceType)</td>

                        <td>
                            <span class="badge @GetBadge(app.Status)">
                                @ApplicationTerminology.ForDisplay(app.Status)
                            </span>
                        </td>

                        <td>
                            @app.DateSubmitted.ToString("yyyy/MM/dd")
                        </td>

                        <td>
                            @app.DateSubmitted.ToString("HH:mm")
                        </td>

                        <td>

                            <a class="btn btn-primary btn-sm"
                               href="/review-application/@app.Id">

                                <PhosphorIcon Name="eye" CssClass="me-1" />

                                Review

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
        <Pagination Page="applications.Page" TotalPages="applications.TotalPages" PageChanged="LoadApplications" AriaLabel="Municipal application pages" />

    </div>

</div>



@code {

    private PagedResult<Application> applications = new([], 0, 1);
    private string? municipality;
    private int totalApplications, inProgressCount, approvedCount, rejectedCount, awaitingReviewCount;

    private string SearchText = "";

    private string SelectedStatus = "All";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var official = await BusinessLicensing_Practice.Services.OfficialAccess.GetAsync(Db, authState.User);

        if (official == null || string.IsNullOrWhiteSpace(official.Municipality))
        {
            applications = new([], 0, 1);
            return;
        }
        municipality = official.Municipality;
        var authorized = Db.Applications.AsNoTracking().Where(application => application.Municipality == municipality);
        totalApplications = await authorized.CountAsync();
        inProgressCount = await authorized.CountAsync(a => a.Status != "Licence Issued" && a.Status != "Rejected" && a.Status != "Withdrawn");
        approvedCount = await authorized.CountAsync(a => a.Status == "Licence Issued");
        rejectedCount = await authorized.CountAsync(a => a.Status == "Rejected" || a.Status == "Withdrawn");
        awaitingReviewCount = await authorized.CountAsync(a => a.Status == "Submitted");
        await LoadApplications();
    }

    private async Task FiltersChanged() => await LoadApplications(1);

    private async Task LoadApplications(int page = 1)
    {
        if (string.IsNullOrWhiteSpace(municipality))
        {
            applications = new([], 0, 1);
            return;
        }
        var query = Db.Applications.AsNoTracking().Where(a => a.Municipality == municipality);
        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var term = SearchText.Trim().ToLowerInvariant();
            query = query.Where(a => a.BusinessName.ToLower().Contains(term) || a.ApplicationNumber.ToLower().Contains(term));
        }
        if (SelectedStatus != "All") query = query.Where(a => a.Status == SelectedStatus);
        var total = await query.CountAsync();
        page = Paging.ClampPage(page, total);
        var items = await query.OrderByDescending(a => a.DateSubmitted).ThenByDescending(a => a.Id)
            .Skip((page - 1) * Paging.PageSize).Take(Paging.PageSize).ToListAsync();
        applications = new(items, total, page);
    }

    private string GetBadge(string status)
    {
        return status switch
        {
            "Submitted" => "bg-secondary",
            "Under Review" => "bg-primary",
            "Additional Information Required" => "bg-warning text-dark",
            "Department Assessment" => "bg-warning text-dark",
            "Final Decision" => "bg-info text-dark",
            "Licence Issued" => "bg-success",
            "Rejected" => "bg-danger",
            "Withdrawn" => "bg-dark",
            _ => "bg-secondary"
        };
    }

}
