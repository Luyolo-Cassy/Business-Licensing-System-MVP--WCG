@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@using BusinessLicensing_Practice.Models

<PageTitle>Home</PageTitle>

<section class="py-5 text-center">
    <div class="container">
        <div class="mx-auto" style="max-width: 860px;">
            <h1 class="display-4 fw-bold text-primary mb-3">Provincial Business Licensing System</h1>
            <p class="lead text-muted mb-4">
                Apply for, manage and track business licence applications online across the Western Cape.
            </p>
            <AuthorizeView Context="auth">

                <Authorized>

                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">

                        @if (auth.User.IsInRole("BusinessOwner"))
                        {
                            <a class="btn btn-primary btn-lg px-4" href="/new-application">
                                Apply for a Licence
                            </a>

                            <a class="btn btn-outline-primary btn-lg px-4" href="/dashboard">
                                Review My Applications
                            </a>
                        }
                        else if (auth.User.IsInRole("MunicipalOfficial"))
                        {
                            <a class="btn btn-primary btn-lg px-4" href="/official-dashboard">
                                Review Applications
                            </a>
                        }
                        else if (auth.User.IsInRole("DEDATAdmin"))
                        {
                            <a class="btn btn-primary btn-lg px-4" href="/admin-dashboard">
                                Review Applications
                            </a>
                        }

                    </div>

                    <p class="text-success mt-3">
                        Welcome back, @currentUser?.FullName
                    </p>

                </Authorized>

                <NotAuthorized>

                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">

                        <a class="btn btn-primary btn-lg px-4" href="/Account/Login">
                            Apply for a Licence
                        </a>

                        <a class="btn btn-outline-primary btn-lg px-4" href="/Account/Login">
                            Review Applications
                        </a>

                        <a class="btn btn-outline-secondary btn-lg px-4" href="/Account/Register">
                            Create Account
                        </a>

                    </div>

                </NotAuthorized>

            </AuthorizeView>
        </div>
    </div>
</section>

<section class="pb-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6 col-xl-3">
                <div class="card h-100 border-light shadow-sm">
                    <div class="card-body">
                        <svg class="bi text-primary mb-3" width="32" height="32" fill="currentColor" viewBox="0 0 16 16"
                             aria-hidden="true">
                            <path
                            d="M6.5 1A1.5 1.5 0 0 0 5 2.5V3H1.5A1.5 1.5 0 0 0 0 4.5v8A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-8A1.5 1.5 0 0 0 14.5 3H11v-.5A1.5 1.5 0 0 0 9.5 1h-3Zm0 1h3a.5.5 0 0 1 .5.5V3H6v-.5a.5.5 0 0 1 .5-.5Z" />
                        </svg>
                        <h5 class="card-title">Apply Online</h5>
                        <p class="card-text text-muted">Submit new business licence applications digitally.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="card h-100 border-light shadow-sm">
                    <div class="card-body">
                        <svg class="bi text-primary mb-3" width="32" height="32" fill="currentColor" viewBox="0 0 16 16"
                             aria-hidden="true">
                            <path
                            d="M.5 9.9a.5.5 0 0 1 .5.5v2.1A1.5 1.5 0 0 0 2.5 14h11a1.5 1.5 0 0 0 1.5-1.5v-2.1a.5.5 0 0 1 1 0v2.1a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 0 12.5v-2.1a.5.5 0 0 1 .5-.5Z" />
                            <path
                            d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3Z" />
                        </svg>
                        <h5 class="card-title">Upload Documents</h5>
                        <p class="card-text text-muted">Securely upload supporting documentation.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="card h-100 border-light shadow-sm">
                    <div class="card-body">
                        <svg class="bi text-primary mb-3" width="32" height="32" fill="currentColor" viewBox="0 0 16 16"
                             aria-hidden="true">
                            <path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1Z" />
                            <path
                            d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466Z" />
                        </svg>
                        <h5 class="card-title">Track Progress</h5>
                        <p class="card-text text-muted">Monitor your application from submission to approval.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="card h-100 border-light shadow-sm">
                    <div class="card-body">
                        <svg class="bi text-primary mb-3" width="32" height="32" fill="currentColor" viewBox="0 0 16 16"
                             aria-hidden="true">
                            <path
                            d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87A1.54 1.54 0 0 0 1.134 2.9c.06 4.23 1.515 7.46 3.735 9.475A9.85 9.85 0 0 0 8 14.5a9.85 9.85 0 0 0 3.131-2.125c2.22-2.015 3.674-5.245 3.735-9.475a1.54 1.54 0 0 0-1.051-1.47A44.8 44.8 0 0 0 10.928.56C9.843.265 8.69 0 8 0Zm2.854 5.146a.5.5 0 0 1 0 .708l-3.5 3.5a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7 8.293l3.146-3.147a.5.5 0 0 1 .708 0Z" />
                        </svg>
                        <h5 class="card-title">Automatic Official PDF</h5>
                        <p class="card-text text-muted">Your completed official application PDF is generated when you submit.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-light border-top border-bottom">
    <div class="container">
        <h2 class="h4 fw-bold text-center mb-4">Application Process</h2>
        <div class="row g-3 align-items-stretch text-center">
            <div class="col-md">
                <div class="card h-100 border-light shadow-sm">
                    <div class="card-body">
                        <span class="badge rounded-pill text-bg-primary mb-2">Step 1</span>
                        <h6 class="mb-0">Choose Licence Type</h6>
                    </div>
                </div>
            </div>
            <div class="col-md-auto d-none d-md-flex align-items-center text-primary fw-bold">&darr;</div>
            <div class="col-md">
                <div class="card h-100 border-light shadow-sm">
                    <div class="card-body">
                        <span class="badge rounded-pill text-bg-primary mb-2">Step 2</span>
                        <h6 class="mb-0">Complete Application</h6>
                    </div>
                </div>
            </div>
            <div class="col-md-auto d-none d-md-flex align-items-center text-primary fw-bold">&darr;</div>
            <div class="col-md">
                <div class="card h-100 border-light shadow-sm">
                    <div class="card-body">
                        <span class="badge rounded-pill text-bg-primary mb-2">Step 3</span>
                        <h6 class="mb-0">Upload Supporting Documents</h6>
                    </div>
                </div>
            </div>
            <div class="col-md-auto d-none d-md-flex align-items-center text-primary fw-bold">&darr;</div>
            <div class="col-md">
                <div class="card h-100 border-light shadow-sm">
                    <div class="card-body">
                        <span class="badge rounded-pill text-bg-primary mb-2">Step 4</span>
                        <h6 class="mb-0">Review, Submit &amp; Track</h6>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<footer class="py-4 text-center text-muted">
    <div class="container">
        <div class="fw-semibold">Provincial Business Licensing Digital System</div>
        <div>Western Cape Government Prototype</div>
    </div>
</footer>


@code {

    private ApplicationUser? currentUser;


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        currentUser = await UserManager.GetUserAsync(authState.User);
    }

}

