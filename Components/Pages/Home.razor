@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Provincial Business Licensing System</PageTitle>

<AuthorizeView Context="auth">
    <Authorized>
        <div class="authenticated-home">
            <h1>Provincial Business Licensing System</h1>
            <p>Welcome back. Continue using your dashboard.</p>
            @if (auth.User.IsInRole("BusinessOwner"))
            {
                <a class="btn btn-primary" href="/dashboard">Go to dashboard</a>
            }
            else if (auth.User.IsInRole("MunicipalOfficial"))
            {
                <a class="btn btn-primary" href="/official-dashboard">Go to dashboard</a>
            }
            else if (auth.User.IsInRole("DEDATAdmin"))
            {
                <a class="btn btn-primary" href="/admin-dashboard">Go to dashboard</a>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="public-home">
            <header class="public-header">
                <div class="public-container public-header-inner">
                    <a class="public-logo-link" href="/" aria-label="Western Cape Government home">
                        <img src="/images/WCG_logo.jpg" alt="Western Cape Government" />
                    </a>
                    <a class="public-sign-in" href="/Account/Login">Sign in</a>
                </div>
            </header>

            <main>
                <section class="public-hero" aria-labelledby="hero-heading">
                    <div class="public-hero-art" aria-hidden="true">
                        <span class="public-hero-outline public-hero-outline-one"></span>
                        <span class="public-hero-outline public-hero-outline-two"></span>
                    </div>
                    <div class="public-container public-hero-inner">
                        <div class="public-hero-copy">
                            <h1 id="hero-heading">Provincial Business<br class="desktop-break" /> Licensing System</h1>
                            <p>Apply for and manage your Western Cape<br class="desktop-break" /> business licence online.</p>
                            <a class="public-apply" href="/Account/Login?returnUrl=%2Fnew-application">
                                <PhosphorIcon Name="file-plus" />
                                <span>Apply for a business licence</span>
                                <PhosphorIcon Name="arrow-right" CssClass="public-apply-arrow" />
                            </a>
                            <p class="public-register">New here? <a href="/Account/Register?returnUrl=%2Fnew-application">Create an account</a></p>
                        </div>
                    </div>
                </section>

                <section class="public-steps" aria-labelledby="steps-heading">
                    <div class="public-container">
                        <div class="public-steps-heading">
                            <h2 id="steps-heading">How it works</h2>
                            <p>Get your business licence in three simple steps.</p>
                        </div>
                        <ol class="public-step-list">
                            <li class="public-step">
                                <span class="public-step-number">STEP 1</span>
                                <span class="public-step-icon"><PhosphorIcon Name="file-text" /></span>
                                <h3>Apply online</h3>
                                <p>Complete your application through our secure system.</p>
                            </li>
                            <li class="public-step">
                                <span class="public-step-number">STEP 2</span>
                                <span class="public-step-icon"><PhosphorIcon Name="upload-simple" /></span>
                                <h3>Submit documents</h3>
                                <p>Upload the required forms and supporting documents.</p>
                            </li>
                            <li class="public-step">
                                <span class="public-step-number">STEP 3</span>
                                <span class="public-step-icon"><PhosphorIcon Name="magnifying-glass" /></span>
                                <h3>Track progress</h3>
                                <p>Monitor the status of your application online.</p>
                            </li>
                        </ol>
                    </div>
                </section>
            </main>

            <footer class="public-footer">
                <div class="public-container public-footer-inner">
                    <span class="public-footer-logo"><img src="/images/WCG_logo.jpg" alt="Western Cape Government" /></span>
                    <span>Provincial Business Licensing System</span>
                </div>
            </footer>
        </div>
    </NotAuthorized>
</AuthorizeView>
