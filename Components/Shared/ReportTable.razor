@using BusinessLicensing_Practice.Services
<div class="card shadow-sm table-responsive"><table class="table table-striped align-middle mb-0"><thead><tr>@foreach (var column in Columns) { <th>@column.Heading</th> }</tr></thead><tbody>
@if (Rows.Count == 0) { <tr><td colspan="@Columns.Count" class="text-center text-muted py-4">No results match the selected filters.</td></tr> }
else { @foreach (var row in VisibleRows) { <tr>@foreach (var column in Columns) { <td>@row.Values.GetValueOrDefault(column.Key, "N/A")</td> }</tr> } }
</tbody></table></div>
<Pagination Page="page" TotalPages="TotalPages" PageChanged="ChangePage" AriaLabel="Report table pages" />

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ReportColumn> Columns { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<ReportRow> Rows { get; set; } = [];
    private IReadOnlyList<ReportRow>? previousRows;
    private int page = 1;
    private int TotalPages => Paging.TotalPages(Rows.Count);
    private IEnumerable<ReportRow> VisibleRows => Rows.Skip((page - 1) * Paging.PageSize).Take(Paging.PageSize);

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(previousRows, Rows)) page = 1;
        previousRows = Rows;
        page = Math.Clamp(page, 1, TotalPages);
    }

    private void ChangePage(int value) => page = Math.Clamp(value, 1, TotalPages);
}
