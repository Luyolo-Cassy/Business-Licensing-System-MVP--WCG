@page "/Account/RegisterConfirmation"

<PageTitle>Check your email</PageTitle>

<main class="auth-page">
    <section class="auth-panel" aria-labelledby="auth-heading">
        <a class="auth-logo" href="/" aria-label="Western Cape Government home">
            <img src="/images/WCG_logo.jpg" alt="Western Cape Government" />
        </a>
        <h1 id="auth-heading">Check your email</h1>
        <p class="auth-intro">Your account has been created successfully.</p>
        <div class="auth-status" role="status">
            <p>We sent you a confirmation email. Open the link in that email to confirm your address before signing in.</p>
        </div>
        <a class="auth-submit btn btn-primary" href="/Account/Login">Back to sign in</a>
    </section>
</main>
