@page "/Account/ConfirmEmail"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using BusinessLicensing_Practice.Data
@using BusinessLicensing_Practice.Models

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Confirm email</PageTitle>

<main class="auth-page">
    <section class="auth-panel" aria-labelledby="auth-heading">
        <a class="auth-logo" href="/" aria-label="Western Cape Government home">
            <img src="/images/WCG_logo.jpg" alt="Western Cape Government" />
        </a>
        <h1 id="auth-heading">Confirm your email</h1>
        <p class="auth-intro">Email confirmation protects access to your account.</p>
        <StatusMessage Message="@statusMessage" />
        @if (confirmationSucceeded)
        {
            <a class="auth-submit btn btn-primary" href="/Account/Login">Sign in</a>
        }
        else if (statusMessage is not null)
        {
            <p class="auth-register-link"><a href="/Account/Login">Back to sign in</a></p>
        }
    </section>
</main>

@code {
    private string? statusMessage;
    private bool confirmationSucceeded;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Code is null)
        {
            RedirectManager.RedirectTo("");
            return;
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            statusMessage = $"Error loading user with ID {UserId}";
        }
        else
        {
            var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            var result = await UserManager.ConfirmEmailAsync(user, code);
            confirmationSucceeded = result.Succeeded;
            statusMessage = result.Succeeded
                ? "Your email address has been successfully confirmed. You can now sign in."
                : "Error confirming your email.";
        }
    }
}
