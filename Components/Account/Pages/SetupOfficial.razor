@page "/Account/Setup-Official"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using BusinessLicensing_Practice.Services
@inject OfficialManagementService Officials

<PageTitle>Set Up Your Official Account</PageTitle>
<HeadContent><meta name="referrer" content="no-referrer" /></HeadContent>

<main class="auth-page">
    <section class="auth-panel" aria-labelledby="auth-heading">
        <a class="auth-logo" href="/" aria-label="Western Cape Government home">
            <img src="/images/WCG_logo.jpg" alt="Western Cape Government" />
        </a>
        <h1 id="auth-heading">Set Up Your Official Account</h1>
        <p class="auth-intro">Create your own password for your Municipal Official account.</p>

        @if (success)
        {
            <div class="auth-status" role="status">
                <p>Your password has been set. You can now log in with your email and password.</p>
            </div>
            <a class="auth-submit btn btn-primary" href="Account/Login">Go to Login</a>
        }
        else if (!valid)
        {
            <div class="alert alert-danger" role="alert">This setup link is invalid, expired, or already used. Contact your administrator for assistance.</div>
            <p class="auth-register-link"><a href="/Account/Login">Back to sign in</a></p>
        }
        else
        {
            @if (error != null) { <div class="alert alert-danger" role="alert">@error</div> }
            <EditForm Model="Input" method="post" FormName="official-setup" OnValidSubmit="Complete" data-busy-form="official-setup">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="auth-field form-floating">
                    <InputText id="password" type="password" class="form-control" autocomplete="new-password"
                               aria-required="true" placeholder="Please enter your password." @bind-Value="Input.Password" />
                    <label for="password" class="form-label">New Password</label>
                    <ValidationMessage For="() => Input.Password" class="text-danger" />
                </div>
                <div class="auth-field form-floating">
                    <InputText id="confirm-password" type="password" class="form-control" autocomplete="new-password"
                               aria-required="true" placeholder="Please confirm your password." @bind-Value="Input.ConfirmPassword" />
                    <label for="confirm-password" class="form-label">Confirm Password</label>
                    <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
                </div>
                <button type="submit" class="auth-submit btn btn-primary" data-busy-submit data-busy-text="Setting password...">Set Password</button>
            </EditForm>
        }
    </section>
</main>

@code {
    [SupplyParameterFromQuery] private string? UserId { get; set; }
    [SupplyParameterFromQuery] private string? Code { get; set; }
    [SupplyParameterFromForm] private PasswordInput Input { get; set; } = default!;
    private bool valid;
    private bool success;
    private string? error;
    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        valid = await Officials.ValidateSetupAsync(UserId, Code);
    }
    private async Task Complete()
    {
        try
        {
            await Officials.CompleteSetupAsync(UserId, Code, Input.Password);
            Input = new(); success = true;
        }
        catch (ValidationException exception) { error = exception.Message; }
    }
    private sealed class PasswordInput
    {
        [Required, DataType(DataType.Password)]
        public string Password { get; set; } = "";
        [Required, Compare(nameof(Password), ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
