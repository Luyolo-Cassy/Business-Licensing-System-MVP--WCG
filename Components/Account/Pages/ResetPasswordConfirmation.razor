@page "/Account/ResetPasswordConfirmation"
<PageTitle>Password reset complete</PageTitle>

<main class="auth-page">
    <section class="auth-panel" aria-labelledby="auth-heading">
        <a class="auth-logo" href="/" aria-label="Western Cape Government home">
            <img src="/images/WCG_logo.jpg" alt="Western Cape Government" />
        </a>
        <h1 id="auth-heading">Password reset complete</h1>
        <p class="auth-intro">Your password has been reset successfully.</p>
        <div class="auth-status" role="status">
            <p>You can now sign in using your new password.</p>
        </div>
        <a class="auth-submit btn btn-primary" href="/Account/Login">Sign in</a>
    </section>
</main>
